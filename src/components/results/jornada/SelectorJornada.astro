---
interface Jornada {
  info: {
    numero: number;
    fechaInicio?: string;
    fechaFin?: string;
    tipo?: string;
    mensaje?: string;
  };
}

interface Props {
  jornadas: Jornada[];
  jornadaSeleccionada: string;
  seccion: string;
}

const { jornadas = [], jornadaSeleccionada = "ultima", seccion = "todas" } = Astro.props as Props;

// Asegurarse de que las jornadas estén en el formato correcto
jornadas.sort((a: Jornada, b: Jornada) => {
  const numA = a?.info?.numero || 0;
  const numB = b?.info?.numero || 0;
  return numB - numA;
});

// Función para obtener el texto a mostrar de una jornada
const obtenerTextoJornada = (jornada: Jornada) => {
  const { info } = jornada;
  
  // Comprobar si hay información de la jornada
  if (!info) return "Jornada sin información";
  
  let texto = `Jornada ${info.numero}`;
  
  // Añadir información de fechas si están disponibles
  if (info.fechaInicio) {
    const formatoFecha = (fecha: string) => {
      if (!fecha) return "";
      // Convertir formato DD-MM-YYYY a DD/MM
      if (/^\d{2}-\d{2}-\d{4}$/.test(fecha)) {
        const [dia, mes] = fecha.split("-");
        return `${dia}/${mes}`;
      }
      return fecha;
    };
    
    texto += ` (${formatoFecha(info.fechaInicio)}`;
    
    if (info.fechaFin && info.fechaFin !== info.fechaInicio) {
      texto += ` - ${formatoFecha(info.fechaFin)}`;
    }
    
    texto += ")";
  }
  
  // Añadir tipo de jornada si está disponible
  if (info.tipo) {
    texto += ` - ${info.tipo}`;
  }
  
  return texto;
};

// Función para ir a una jornada
const irAJornada = (numeroJornada: number) => {
  const url = new URL(window.location.href);
  url.searchParams.set('jornada', numeroJornada.toString());
  window.location.href = url.toString();
};

// Ordenar jornadas por número (de mayor a menor)
const jornadasOrdenadas = jornadas.sort((a: Jornada, b: Jornada) => {
  return (b?.info?.numero || 0) - (a?.info?.numero || 0);
});

// Determinar la jornada actual
const jornadaActual = jornadaSeleccionada === "ultima" 
  ? jornadas[0]?.info?.numero 
  : parseInt(jornadaSeleccionada) || jornadas[0]?.info?.numero;

---

<div class="selector-jornada">
  <div class="flex flex-col space-y-6">
    <!-- Selector de Jornada (con formulario) -->
    <div class="relative mx-auto w-full md:w-2/3 lg:w-1/2">
      <label for="select-jornada" class="block text-white text-sm font-medium mb-2">Selecciona una jornada:</label>
      <form id="form-jornada" method="get" action="javascript:void(0);">
        <div class="relative">
          <select 
            id="select-jornada"
            name="id"
            class="block w-full bg-green-950 text-white border border-green-700 rounded-lg py-3 px-4 appearance-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-green-500 text-lg"
            onchange="cambiarJornada(this.value);"
          >
            {jornadasOrdenadas.map((jornada: Jornada) => (
              <option 
                value={jornada.info.numero} 
                selected={jornadaActual === jornada.info.numero}
              >
                {obtenerTextoJornada(jornada)}
              </option>
            ))}
          </select>
          <input type="hidden" name="seccion" value={seccion} />
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-white">
            <svg class="fill-current h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
              <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
            </svg>
          </div>
        </div>
      </form>
    </div>
    
    <!-- Botones de Sección (optimizado para móvil) -->
    <div class="mt-4">
      <div class="flex justify-center mb-2">
        <span class="text-white text-sm font-medium">Filtrar por sección:</span>
      </div>
      <div class="grid grid-cols-3 gap-2 sm:gap-4">
        <a 
          href={`/resultados/jornada/${jornadaActual}?seccion=masculina`}
          class={`flex flex-col sm:flex-row items-center justify-center py-3 px-2 sm:px-4 rounded-lg transition-colors shadow-md text-white font-medium ${seccion === 'masculina' ? 'bg-blue-600 hover:bg-blue-700' : 'bg-green-800 hover:bg-green-700'}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mb-1 sm:mb-0 sm:mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span class="text-xs sm:text-base">Masculina</span>
        </a>
        <a 
          href={`/resultados/jornada/${jornadaActual}?seccion=todas`}
          class={`flex flex-col sm:flex-row items-center justify-center py-3 px-2 sm:px-4 rounded-lg transition-colors shadow-md text-white font-medium ${seccion === 'todas' ? 'bg-green-600 hover:bg-green-700' : 'bg-green-800 hover:bg-green-700'}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mb-1 sm:mb-0 sm:mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
          </svg>
          <span class="text-xs sm:text-base">Todas</span>
        </a>
        <a 
          href={`/resultados/jornada/${jornadaActual}?seccion=femenina`}
          class={`flex flex-col sm:flex-row items-center justify-center py-3 px-2 sm:px-4 rounded-lg transition-colors shadow-md text-white font-medium ${seccion === 'femenina' ? 'bg-pink-600 hover:bg-pink-700' : 'bg-green-800 hover:bg-green-700'}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mb-1 sm:mb-0 sm:mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span class="text-xs sm:text-base">Femenina</span>
        </a>
      </div>
    </div>
    
    <!-- Elemento oculto para pasar jornadaActual al script -->
    <div data-jornada-actual={jornadaActual.toString()} class="hidden"></div>
  </div>
</div>

<script is:inline>
  // Función para cambiar de jornada
  function cambiarJornada(jornadaId) {
    // Obtener la sección actual
    const seccionInput = document.querySelector('input[name="seccion"]');
    const seccion = seccionInput ? seccionInput.value : 'todas';
    
    // Construir la URL correcta
    const nuevaUrl = `/resultados/jornada/${jornadaId}?seccion=${seccion}`;
    
    // Redirigir a la nueva URL
    window.location.href = nuevaUrl;
  }
  
  // Asegurarnos de que el script se ejecute después de que el DOM esté completamente cargado
  document.addEventListener('DOMContentLoaded', () => {
    // Obtener el elemento select
    const selectJornada = document.getElementById('select-jornada');
    
    if (selectJornada) {
      // Inicializar el valor del selector con el valor actual
      const jornadaActualElement = document.querySelector('[data-jornada-actual]');
      const jornadaActual = jornadaActualElement ? jornadaActualElement.getAttribute('data-jornada-actual') : null;
      
      if (jornadaActual) {
        selectJornada.value = jornadaActual;
      }
      
      // Verificar que el selector funcione correctamente
      console.log('Selector de jornada inicializado con valor:', selectJornada.value);
    } else {
      console.error('No se encontró el elemento select-jornada');
    }
  });
</script>

