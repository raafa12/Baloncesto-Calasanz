---
import JornadaHeader from './ResultadosJornada/JornadaHeader.astro';
import ResultadoCard from './ResultadosJornada/ResultadoCard.astro';
import { secciones } from '../data/equipos';
import { obtenerUltimaJornada, obtenerJornadaPorNumero } from '../data/jornadas/temporadas';

const { jornadaNumero = "ultima", seccionSeleccionada = "masculina", temporada = null } = Astro.props;

// Depuración
console.log(`[ResultadosJornadaConActuaciones] Recibido: jornadaNumero=${jornadaNumero}, seccion=${seccionSeleccionada}`);

let jornada;

try {
  if (jornadaNumero === "ultima") {
    jornada = await obtenerUltimaJornada(temporada);
    console.log(`[ResultadosJornadaConActuaciones] Cargando última jornada: ${jornada?.info?.numero ?? 'No encontrada'}`);
  } else {
    jornada = await obtenerJornadaPorNumero(parseInt(jornadaNumero), temporada);
    console.log(`[ResultadosJornadaConActuaciones] Cargando jornada #${jornadaNumero}: ${jornada ? 'OK' : 'No encontrada'}`);
  }
} catch (err) {
  console.error("Error cargando la jornada:", err);
}

let resultadosFiltrados = [];
let seccion = secciones[seccionSeleccionada] || { nombre: "Sección", color: "gray-500" };

if (jornada) {
  resultadosFiltrados = jornada.resultados.filter(r => {
    const esMasculina = seccionSeleccionada === "masculina";
    return esMasculina ? r.categoria.includes("Masculino") : r.categoria.includes("Femenino");
  });

  console.log(`[ResultadosJornadaConActuaciones] Resultados encontrados (${seccionSeleccionada}): ${resultadosFiltrados.length}`);
}
---

{!jornada ? (
  <div class="bg-red-900 text-white p-4 rounded">
    No se encontraron datos para la jornada seleccionada. (Jornada: {jornadaNumero})
  </div>
) : (
  <div class="resultados-jornada">
    <JornadaHeader jornada={jornada} />

    <div>
      <div class="flex items-center mb-4 border-b border-green-700 pb-2">
        <div class={`w-2 h-6 bg-${seccion.color} mr-3 rounded`}></div>
        <h4 class="text-lg font-semibold text-white">{seccion.nombre}</h4>
      </div>

      <div class="grid grid-cols-1 gap-8">
        {resultadosFiltrados.length > 0 ? (
          resultadosFiltrados.map((resultado) => (
            <ResultadoCard 
              resultado={resultado} 
              seccion={seccionSeleccionada}
            />
          ))
        ) : (
          <div class="text-gray-400 text-center py-8">
            No hay resultados disponibles para esta sección en la jornada seleccionada.
          </div>
        )}
      </div>
    </div>
  </div>
)}
