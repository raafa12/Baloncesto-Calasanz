// Obtener los datos de la jornada seleccionada
const jornada = jornadasData[jornadaSeleccionada] || jornadasData["ultima"];
const actuacionesJornada = actuacionesData[jornadaSeleccionada] || actuacionesData["ultima"];

// Filtrar los resultados según la sección seleccionada
const resultadosFiltrados = jornada.resultados.filter(r => {
  if (seccionSeleccionada === "masculina") {
    return r.categoria.includes("Masculino");
  } else {
    return r.categoria.includes("Femenino");
  }
});

// Función para determinar si un equipo es ganador
const esGanador = (resultado, esLocal) => {
  if (esLocal) {
    return resultado.puntosLocal > resultado.puntosVisitante;
  } else {
    return resultado.puntosVisitante > resultado.puntosLocal;
  }
};

// Función para determinar si un equipo es CB Calasanz
const esCalasanz = (nombre) => nombre === "CB Calasanz";

// Función para obtener la actuación destacada correspondiente a un resultado
const obtenerActuacionDestacada = (categoria) => {
  return actuacionesJornada.actuaciones.find(a => a.equipo === categoria);
};

// Determinar el color de la sección
const colorSeccion = seccionSeleccionada === "masculina" ? "bg-blue-500" : "bg-pink-500";
const tituloSeccion = seccionSeleccionada === "masculina" ? "Sección Masculina" : "Sección Femenina";
---

<div class="resultados-jornada">
  <div class="mb-6 flex justify-between items-center">
    <h3 class="text-xl font-semibold text-green-300">Jornada {jornada.numero} - {jornada.fecha}</h3>
  </div>
  
  <!-- SECCIÓN (MASCULINA O FEMENINA) -->
  <div>
    <div class="flex items-center mb-4 border-b border-green-700 pb-2">
      <div class={`w-2 h-6 ${colorSeccion} mr-3 rounded`}></div>
      <h4 class="text-lg font-semibold text-white">{tituloSeccion}</h4>
    </div>
    
    <div class="grid grid-cols-1 gap-8">
      {resultadosFiltrados.map((resultado) => {
        const actuacionDestacada = obtenerActuacionDestacada(resultado.categoria);
        
        return (
          <div class="bg-green-950 border border-green-800 rounded-xl overflow-hidden shadow-lg">
            {/* Cabecera con la categoría y fecha */}
            <div class="bg-green-800/50 px-4 py-2 flex justify-between items-center">
              <span class="text-sm font-medium text-green-200">{resultado.categoria}</span>
              <span class="text-xs text-green-300">{resultado.fecha}</span>
            </div>
            
            <div class="p-5">
              {/* Resultado del partido */}
              <div class="mb-4">
                {/* Equipo Local */}
                <div class="flex justify-between items-center mb-2">
                  <div class="flex items-center">
                    <div class={`w-1 h-6 rounded-full mr-3 ${esCalasanz(resultado.local) ? "bg-green-400" : "bg-transparent"}`}></div>
                    <span class={`font-medium ${esGanador(resultado, true) ? "text-white" : "text-gray-400"}`}>
                      {resultado.local}
                    </span>
                  </div>
                  <span class={`text-2xl font-bold ${esGanador(resultado, true) ? "text-white" : "text-gray-400"}`}>
                    {resultado.puntosLocal}
                  </span>
                </div>
                
                {/* Equipo Visitante */}
                <div class="flex justify-between items-center">
                  <div class="flex items-center">
                    <div class={`w-1 h-6 rounded-full mr-3 ${esCalasanz(resultado.visitante) ? "bg-green-400" : "bg-transparent"}`}></div>
                    <span class={`font-medium ${esGanador(resultado, false) ? "text-white" : "text-gray-400"}`}>
                      {resultado.visitante}
                    </span>
                  </div>
                  <span class={`text-2xl font-bold ${esGanador(resultado, false) ? "text-white" : "text-gray-400"}`}>
                    {resultado.puntosVisitante}
                  </span>
                </div>
                
                {/* Pabellón */}
                <div class="mt-2 text-xs text-gray-400">
                  <span>{resultado.pabellon}</span>
                </div>
              </div>
              
              {/* Línea divisoria */}
              <div class="border-t border-green-800 my-4"></div>
              
              {/* Actuación Destacada */}
              {actuacionDestacada && (
                <div class="mt-3">
                  <div class="flex items-center mb-2">
                    <span class="text-sm font-semibold text-green-400">Actuación Destacada</span>
                  </div>
                  
                  <div class="flex items-center mb-3">
                    <div class="w-10 h-10 bg-green-700 rounded-full flex items-center justify-center mr-3">
                      <span class="text-md font-bold text-white">{actuacionDestacada.jugador.charAt(0)}</span>
                    </div>
                    <div>
                      <h5 class="font-bold text-white">{actuacionDestacada.jugador}</h5>
                      <p class="text-sm text-green-300">{actuacionDestacada.estadisticas}</p>
                    </div>
                  </div>
                  
                  <div class="bg-green-800/30 p-3 rounded text-sm text-gray-300">
                    <span class="font-semibold text-green-400">Destacado:</span> {actuacionDestacada.destacado}
                  </div>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>