<!-- src/components/ResultadosJornada/ResultadoCard.astro -->
---
import ActuacionDestacada from '../ResultadosJornada/ActuacionDestacada.astro';

const { resultado, seccion = "masculina" } = Astro.props;
const {
  categoria,
  local,
  visitante,
  puntosLocal,
  puntosVisitante,
  fecha,
  hora,
  lugar,
  jugadorDestacado,
  comentarioJugador
} = resultado;

// Determinar si es victoria, derrota o no jugado
let estado = "";
let claseEstado = "";

if (puntosLocal !== null && puntosVisitante !== null) {
  const esCalasanzLocal = local.toLowerCase().includes('calasanz');
  const puntosCalasanz = esCalasanzLocal ? puntosLocal : puntosVisitante;
  const puntosRival = esCalasanzLocal ? puntosVisitante : puntosLocal;
  
  if (puntosCalasanz > puntosRival) {
    estado = "VICTORIA";
    claseEstado = "bg-green-700";
  } else if (puntosCalasanz < puntosRival) {
    estado = "DERROTA";
    claseEstado = "bg-red-700";
  } else if (puntosCalasanz === puntosRival) {
    estado = "EMPATE";
    claseEstado = "bg-yellow-700";
  }
} else {
  estado = "NO JUGADO";
  claseEstado = "bg-gray-700";
}
---

<div class="bg-green-950 rounded-lg overflow-hidden shadow-lg transition-transform hover:scale-[1.02] hover:shadow-xl">
  <div class="p-4 md:p-6">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-xl md:text-2xl font-bold text-white">{categoria}</h3>
      <div class={`${claseEstado} px-3 py-1 rounded-full text-white text-sm font-medium`}>
        {estado}
      </div>
    </div>
    
    <!-- Equipos y resultado - Layout horizontal para móvil y escritorio -->
    <div class="flex flex-row justify-between items-center bg-green-900 bg-opacity-30 p-4 md:p-6 rounded-lg">
      <div class="flex-1 text-left">
        <p class={`text-base md:text-xl font-semibold ${local.toLowerCase().includes('calasanz') ? 'text-green-400' : 'text-white'}`}>
          {local}
        </p>
      </div>
      
      <div class="px-2 md:px-4 flex justify-center items-center">
        {puntosLocal !== null && puntosVisitante !== null ? (
          <div class="text-lg md:text-4xl font-bold text-white">
            {puntosLocal} - {puntosVisitante}
          </div>
        ) : (
          <div class="text-sm md:text-lg font-medium text-gray-400">
            {fecha && hora ? `${fecha} - ${hora}` : 'Por determinar'}
          </div>
        )}
      </div>
      
      <div class="flex-1 text-right">
        <p class={`text-base md:text-xl font-semibold ${visitante.toLowerCase().includes('calasanz') ? 'text-green-400' : 'text-white'}`}>
          {visitante}
        </p>
      </div>
    </div>
    
    <!-- Información adicional -->
    {(fecha || hora || lugar) && (
      <div class="mt-4 text-sm md:text-base text-gray-300 flex flex-wrap items-center">
        {fecha && (
          <span class="mr-3 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {fecha}
          </span>
        )}
        {hora && (
          <span class="mr-3 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {hora}
          </span>
        )}
        {lugar && (
          <span class="flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {lugar}
          </span>
        )}
      </div>
    )}
    
    <!-- Actuación destacada -->
    {jugadorDestacado && comentarioJugador && (
      <div class="mt-4">
        <ActuacionDestacada 
          jugadorNombre={jugadorDestacado} 
          equipo={categoria}
          seccion={seccion}
          comentario={comentarioJugador} 
        />
      </div>
    )}
  </div>
</div>
