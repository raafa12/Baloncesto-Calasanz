---
import ResultadoCard from './ResultadoCard.astro';
import { secciones } from '../../data/equipos';
import { obtenerUltimaJornada, obtenerJornadaPorNumero } from '../../data/jornadas/temporadas';

// Props
let { jornada: jornadaNumero = "ultima", seccion: seccionSeleccionada = "masculina" } = Astro.props;

// Estado inicial
let jornada = null;
let resultadosFiltrados = [];
let seccion = { nombre: "Sección", color: "gray-500" };

// Función para detectar la sección de una categoría
function detectarSeccion(categoria) {
  if (!categoria) return null;
  
  const categoriaLower = categoria.toLowerCase();
  
  if (categoriaLower.includes("mascul") || 
      categoriaLower.includes("macul") || 
      categoriaLower.endsWith(" m") || 
      categoriaLower.includes(" m ")) {
    return "masculina";
  }
  
  if (categoriaLower.includes("femen") || 
      categoriaLower.endsWith(" f") || 
      categoriaLower.includes(" f ")) {
    return "femenina";
  }
  
  return null;
}

// Función para obtener la jornada
async function obtenerJornada() {
  try {
    // Cargar la jornada
    if (jornadaNumero === "ultima") {
      jornada = await obtenerUltimaJornada();
    } else {
      jornada = await obtenerJornadaPorNumero(parseInt(jornadaNumero));
    }

    // Actualizar sección
    seccion = secciones[seccionSeleccionada] || { nombre: "Sección", color: "gray-500" };

    // Filtrar resultados por sección
    if (jornada) {
      resultadosFiltrados = jornada.resultados.filter(r => {
        const seccionDetectada = detectarSeccion(r.categoria);
        
        // Si la sección no se detecta, mostramos solo si coincide con la sección actual
        // para evitar duplicados entre ambas columnas
        if (seccionDetectada === null) {
          return seccionSeleccionada === "masculina";
        }
        
        // Comparamos con la sección seleccionada
        return seccionDetectada === seccionSeleccionada;
      });
    }

    return jornada;
  } catch (err) {
    console.error("Error cargando la jornada:", err);
    return null;
  }
}

// Cargar la jornada inicial
await obtenerJornada();

// Formatear la fecha de la jornada
function formatearFechaJornada(jornada) {
  if (!jornada?.info) return "";
  
  const { fechaInicio, fechaFin } = jornada.info;
  
  if (!fechaInicio) return "";
  
  // Función para formatear una fecha individual
  const formatearFecha = (fechaStr) => {
    if (!fechaStr) return "";
    
    // Si es formato DD-MM-YYYY
    if (/^\d{2}-\d{2}-\d{4}$/.test(fechaStr)) {
      const [dia, mes, anio] = fechaStr.split("-");
      const meses = [
        "enero", "febrero", "marzo", "abril", "mayo", "junio",
        "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"
      ];
      return `${dia} de ${meses[parseInt(mes) - 1]}`;
    }
    
    return fechaStr;
  };
  
  if (fechaInicio && fechaFin && fechaInicio !== fechaFin) {
    return `${formatearFecha(fechaInicio)} - ${formatearFecha(fechaFin)}`;
  }
  
  return formatearFecha(fechaInicio);
}
---

<script>
  // Función para actualizar la URL
  function actualizarURL(nuevaJornada, nuevaSeccion) {
    const url = new URL(window.location.href);
    url.searchParams.set('jornada', nuevaJornada || jornadaNumero);
    url.searchParams.set('seccion', nuevaSeccion || seccionSeleccionada);
    window.history.pushState({}, '', url.toString());
    window.dispatchEvent(new PopStateEvent('popstate'));
  }

  // Escuchar cambios en la URL
  window.addEventListener('popstate', async () => {
    const nuevaJornada = new URLSearchParams(window.location.search).get('jornada') || "ultima";
    const nuevaSeccion = new URLSearchParams(window.location.search).get('seccion') || "masculina";
    
    // Actualizar props
    if (nuevaJornada !== jornadaNumero || nuevaSeccion !== seccionSeleccionada) {
      jornadaNumero = nuevaJornada;
      seccionSeleccionada = nuevaSeccion;
      await obtenerJornada();
    }
  });
</script>-

{!jornada ? (
  <div class="bg-red-900 text-white p-4 rounded">
    No se encontraron datos para la jornada seleccionada. (Jornada: {jornadaNumero})
  </div>
) : (
  <div class="resultados-jornada">
    <div class="grid grid-cols-1 gap-6">
      {resultadosFiltrados.length > 0 ? (
        resultadosFiltrados.map((resultado) => (
          <ResultadoCard 
            resultado={resultado} 
            seccion={seccionSeleccionada}
          />
        ))
      ) : (
        <div class="text-gray-400 text-center py-6 bg-green-950 bg-opacity-40 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 mx-auto mb-2 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p>No hay resultados disponibles para esta sección en la jornada seleccionada.</p>
        </div>
      )}
    </div>
  </div>
)}