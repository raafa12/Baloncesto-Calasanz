<div class="equipos-temporada">

  <!-- Estadísticas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
    <div class="bg-green-900/50 p-6 rounded-lg border border-green-800/30 text-center">
      <div class="text-3xl font-bold text-green-400" id="total-players">{stats.total}</div>
      <div class="text-gray-300">Total Jugadores</div>
    </div>
    <div class="bg-green-900/50 p-6 rounded-lg border border-green-800/30 text-center">
      <div class="text-3xl font-bold text-blue-400" id="male-players">{stats.masculino}</div>
      <div class="text-gray-300">Jugadores</div>
    </div>
    <div class="bg-green-900/50 p-6 rounded-lg border border-green-800/30 text-center">
      <div class="text-3xl font-bold text-pink-400" id="female-players">{stats.femenino}</div>
      <div class="text-gray-300">Jugadoras</div>
    </div>
  </div>

  <!-- Sección de Equipos -->
  <div class="space-y-12">
    <!-- Sección Masculina -->
    <div class="bg-green-950/50 rounded-xl overflow-hidden border border-green-800/30">
      <div class="bg-green-900/70 p-4 border-b border-green-800/30">
        <h2 class="text-xl font-bold flex items-center gap-2">
          <span class="bg-blue-500 text-white rounded-full w-8 h-8 flex items-center justify-center">♂</span>
          SECCIÓN MASCULINA
        </h2>
      </div>
      
      <div class="space-y-4 p-4">
        {Object.entries(playersData.masculino).map(([categoria, jugadores]: [string, Jugador[]]) => (
          <div class="mb-6">
            <div class="flex justify-between items-center bg-green-900/30 p-3 rounded-lg cursor-pointer" 
                 onclick="this.nextElementSibling.classList.toggle('hidden')">
              <h3 class="font-semibold">
                {categoria.charAt(0).toUpperCase() + categoria.slice(1)} 
                <span class="text-sm font-normal text-green-400 ml-2">({jugadores.length} jugadores)</span>
              </h3>
              <span class="text-green-400">▼</span>
            </div>
            <div class="hidden mt-2 bg-green-900/20 p-4 rounded-lg">
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {jugadores.map(jugador => (
                  <div class="bg-green-900/30 p-4 rounded border border-green-800/30">
                    <h4 class="font-medium">{jugador.name}</h4>
                    <p class="text-sm text-gray-400">Nacimiento: {jugador.birth} ({jugador.year})</p>
                    <div class="mt-2 pt-2 border-t border-green-800/30 text-sm">
                      <p>📞 {jugador.phone}</p>
                      <p class="truncate" title={jugador.email}>📧 {jugador.email}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Sección Femenina -->
    <div class="bg-green-950/50 rounded-xl overflow-hidden border border-green-800/30">
      <div class="bg-pink-900/70 p-4 border-b border-pink-800/30">
        <h2 class="text-xl font-bold flex items-center gap-2">
          <span class="bg-pink-500 text-white rounded-full w-8 h-8 flex items-center justify-center">♀</span>
          SECCIÓN FEMENINA
        </h2>
      </div>
      
      <div class="space-y-4 p-4">
        {Object.entries(playersData.femenino).map(([categoria, jugadoras]: [string, Jugador[]]) => (
          <div class="mb-6">
            <div class="flex justify-between items-center bg-pink-900/30 p-3 rounded-lg cursor-pointer"
                 onclick="this.nextElementSibling.classList.toggle('hidden')">
              <h3 class="font-semibold">
                {categoria.charAt(0).toUpperCase() + categoria.slice(1)}
                <span class="text-sm font-normal text-pink-400 ml-2">({jugadoras.length} jugadoras)</span>
              </h3>
              <span class="text-pink-400">▼</span>
            </div>
            <div class="hidden mt-2 bg-pink-900/20 p-4 rounded-lg">
