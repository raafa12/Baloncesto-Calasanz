// Definir tipos
type CategoriaStats = {
  masculino: number;
  femenino: number;
};

type Stats = {
  total: number;
  masculino: number;
  femenino: number;
  categorias: {
    [key: string]: CategoriaStats;
  };
};

// Calcular estadísticas
const stats: Stats = {
  total: 0,
  masculino: 0,
  femenino: 0,
  categorias: {}
};

// Procesar estadísticas
Object.entries(playersData).forEach(([genero, categorias]) => {
  // Type assertion for categorias
  const categoriasData = categorias as CategoriaJugadores;
  
  Object.entries(categoriasData).forEach(([categoria, jugadores]) => {
    stats.total += jugadores.length;
    
    if (genero === 'masculino' || genero === 'femenino') {
      // Type assertion for stats[genero]
      (stats[genero as keyof Omit<Stats, 'total' | 'categorias'>] as number) += jugadores.length;
    }
    
    if (!stats.categorias[categoria]) {
      stats.categorias[categoria] = { masculino: 0, femenino: 0 };
    }
    
    if (genero === 'masculino' || genero === 'femenino') {
      stats.categorias[categoria][genero as keyof CategoriaStats] = jugadores.length;
    }
  });
});
