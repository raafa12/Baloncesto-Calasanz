        function createPlayerCard(player) {
            return `
                <div class="player-card">
                    <div class="player-name">${player.name}</div>
                    <div class="player-details">
                        <div class="player-birth">Nacimiento: ${player.birth} (${player.year})</div>
                        <div class="contact-info">
                            <div>📞 ${player.phone}</div>
                            <div>📧 ${player.email}</div>
                        </div>
                    </div>
                </div>
            `;
        }

        function renderPlayers() {
            let totalMale = 0;
            let totalFemale = 0;

            // Render masculine teams
            Object.entries(playersData.masculino).forEach(([category, players]) => {
                const container = document.getElementById(`${category}-masculino`);
                if (container) {
                    container.innerHTML = players.map(createPlayerCard).join('');
                    totalMale += players.length;

                    // Calculate stats for this category
                    const firstYear = players.filter(p => p.year === "1er año").length;
                    const secondYear = players.filter(p => p.year === "2º año").length;
                    
                    // Update category stats
                    const totalEl = document.getElementById(`total-${category}-masculino`);
                    const firstEl = document.getElementById(`first-${category}-masculino`);
                    const secondEl = document.getElementById(`second-${category}-masculino`);
                    
                    if (totalEl) totalEl.textContent = `${players.length} jugadores`;
                    if (firstEl) firstEl.textContent = `${firstYear} (1º)`;
                    if (secondEl) secondEl.textContent = `${secondYear} (2º)`;
                }
            });

            // Render feminine teams
            Object.entries(playersData.femenino).forEach(([category, players]) => {
                const container = document.getElementById(`${category}-femenino`);
                if (container) {
                    container.innerHTML = players.map(createPlayerCard).join('');
                    totalFemale += players.length;

                    // Calculate stats for this category
                    const firstYear = players.filter(p => p.year === "1er año").length;
                    const secondYear = players.filter(p => p.year === "2º año").length;
                    
                    // Update category stats
                    const totalEl = document.getElementById(`total-${category}-femenino`);
                    const firstEl = document.getElementById(`first-${category}-femenino`);
                    const secondEl = document.getElementById(`second-${category}-femenino`);
                    
                    if (totalEl) totalEl.textContent = `${players.length} jugadoras`;
                    if (firstEl) firstEl.textContent = `${firstYear} (1º)`;
                    if (secondEl) secondEl.textContent = `${secondYear} (2º)`;
                }
            });

            // Update global stats
            document.getElementById('total-players').textContent = totalMale + totalFemale;
            document.getElementById('male-players').textContent = totalMale;
            document.getElementById('female-players').textContent = totalFemale;
        }

        function initializeCollapsibles() {
            // Add click event listeners to category headers
            document.querySelectorAll('.category-header').forEach(header => {
                header.addEventListener('click', function() {
                    const category = this.closest('.category');
                    category.classList.toggle('expanded');
                });
            });
        }

        // Initialize the page
        document.addEventListener('DOMContentLoaded', function() {
            renderPlayers();
            initializeCollapsibles();
        });
    </script>
