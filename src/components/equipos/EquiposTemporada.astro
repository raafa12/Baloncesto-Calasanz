// Definir tipos
type CategoriaStats = {
  baby: number;
  masculino: number;
  femenino: number;
};

type Stats = {
  total: number;
  baby: number;
  masculino: number;
  femenino: number;
  categorias: {
    [key: string]: CategoriaStats;
  };
};

// Calcular estadísticas
const stats: Stats = {
  total: 0,
  baby: 0,
  masculino: 0,
  femenino: 0,
  categorias: {}
};

// Función para contar jugadores en un grupo
const contarJugadores = (grupo: Jugador[] | GrupoJugadores): number => {
  if (Array.isArray(grupo)) {
    return grupo.length;
  } else if (typeof grupo === 'object' && grupo !== null) {
    return (grupo.niños?.length || 0) + (grupo.niñas?.length || 0);
  }
  return 0;
};

// Procesar estadísticas
Object.entries(playersData).forEach(([genero, categorias]) => {
  Object.entries(categorias).forEach(([categoria, jugadores]) => {
    const totalJugadores = contarJugadores(jugadores);
    
    if (genero === 'baby' || genero === 'masculino' || genero === 'femenino') {
      (stats[genero as keyof Omit<Stats, 'total' | 'categorias'>] as number) += totalJugadores;
    }
    
    if (!stats.categorias[categoria]) {
      stats.categorias[categoria] = { baby: 0, masculino: 0, femenino: 0 };
    }
    
    if (genero === 'baby' || genero === 'masculino' || genero === 'femenino') {
      stats.categorias[categoria][genero as keyof CategoriaStats] += totalJugadores;
    }
  });
});

// Actualizar el total general
stats.total = stats.baby + stats.masculino + stats.femenino;

// Función para agrupar jugadores en equipos según la categoría
const agruparEnEquipos = (jugadores: Jugador[], categoria: string, genero: string): {[key: string]: Jugador[]} => {
  if (!Array.isArray(jugadores) || jugadores.length === 0) return {};
  
  // Ordenar jugadores por año de nacimiento (de menor a mayor)
  const jugadoresOrdenados = [...jugadores].sort((a, b) => a.birth - b.birth);
  
  const equipos: {[key: string]: Jugador[]} = {
    'A': [],
    'B': [],
    'C': []
  };

  // Solo aplicar lógica especial para la sección masculina
  if (genero === 'masculino') {
    switch (categoria) {
      case 'benjamin':
        // Benjamín: Equipo A (2º año) y Equipo B (1er año)
        equipos['A'] = jugadoresOrdenados.filter(j => j.year.includes('2º año'));
        equipos['B'] = jugadoresOrdenados.filter(j => j.year.includes('1er año'));
        break;
        
      case 'alevin':
      case 'cadete':
        // Alevín y Cadete: Un solo equipo
        equipos['A'] = [...jugadoresOrdenados];
        delete equipos['B'];
        delete equipos['C'];
        break;
        
      case 'infantil':
        // Infantil: Equipo A (2º año), B (primeros 10 de 1er año), C (resto 1er año)
        const segundoAnio = jugadoresOrdenados.filter(j => j.year.includes('2º año'));
        const primerAnio = jugadoresOrdenados.filter(j => j.year.includes('1er año'));
        equipos['A'] = [...segundoAnio];
        equipos['B'] = primerAnio.slice(0, 10);
        equipos['C'] = primerAnio.slice(10);
        break;
        
      case 'junior':
        // Junior: Equipo A (2º año) y Equipo B (1er año), con excepciones que van al A
        const jugadoresEquipoA = [];
        const jugadoresEquipoB = [];
        
        jugadoresOrdenados.forEach(jugador => {
          if (jugador.year.includes('2º año') || 
              jugador.name === 'Juan Garcia Hierro' || 
              jugador.name === 'Raul León') {
            jugadoresEquipoA.push(jugador);
          } else {
            jugadoresEquipoB.push(jugador);
          }
        });
        
        equipos['A'] = jugadoresEquipoA;
        if (jugadoresEquipoB.length > 0) {
          equipos['B'] = jugadoresEquipoB;
        }
        break;
        
      default:
        // Para cualquier otra categoría, mantener la lógica por defecto
        const totalJugadores = jugadoresOrdenados.length;
        const jugadoresPorEquipo = Math.ceil(totalJugadores / 3);
        
        jugadoresOrdenados.forEach((jugador, index) => {
          if (index < jugadoresPorEquipo) {
            equipos['A'].push(jugador);
          } else if (index < jugadoresPorEquipo * 2) {
            equipos['B'].push(jugador);
          } else {
            equipos['C'].push(jugador);
          }
        });
    }
  } else if (genero === 'femenino') {
    // Lógica para la sección femenina
    switch (categoria) {
      case 'benjamin':
      case 'infantil':
      case 'junior':
        // Benjamín, Infantil y Junior: Un solo equipo
        equipos['A'] = [...jugadoresOrdenados];
        delete equipos['B'];
        delete equipos['C'];
        break;
        
      case 'alevin':
      case 'cadete':
        // Alevín y Cadete: Equipo A (2º año) y Equipo B (1er año)
        equipos['A'] = jugadoresOrdenados.filter(j => j.year.includes('2º año'));
        const primerAnio = jugadoresOrdenados.filter(j => j.year.includes('1er año'));
        if (primerAnio.length > 0) {
          equipos['B'] = primerAnio;
        } else {
          delete equipos['B'];
        }
        delete equipos['C'];
        break;
        
      default:
        // Para cualquier otra categoría, mantener la lógica por defecto
        const totalJugadores = jugadoresOrdenados.length;
        const jugadoresPorEquipo = Math.ceil(totalJugadores / 3);
        
        jugadoresOrdenados.forEach((jugador, index) => {
          if (index < jugadoresPorEquipo) {
            equipos['A'].push(jugador);
          } else if (index < jugadoresPorEquipo * 2) {
            equipos['B'].push(jugador);
          } else {
            equipos['C'].push(jugador);
          }
        });
    }
  } else {
    // Para la sección baby u otros casos
    const totalJugadores = jugadoresOrdenados.length;
    const jugadoresPorEquipo = Math.ceil(totalJugadores / 3);
    
    jugadoresOrdenados.forEach((jugador, index) => {
      if (index < jugadoresPorEquipo) {
        equipos['A'].push(jugador);
      } else if (index < jugadoresPorEquipo * 2) {
        equipos['B'].push(jugador);
      } else {
        equipos['C'].push(jugador);
      }
    });
  }
  
  // Eliminar equipos vacíos
  Object.keys(equipos).forEach(key => {
    if (equipos[key].length === 0) {
      delete equipos[key];
    }
  });
  
  return equipos;
};

// Procesar las categorías para incluir equipos
const procesarCategorias = (data: PlayersData) => {
  const resultado: any = { masculino: {}, femenino: {} };
  
  // Procesar sección masculina
  Object.entries(data.masculino).forEach(([categoria, jugadores]) => {
    if (Array.isArray(jugadores)) {
      const equipos = agruparEnEquipos(jugadores, categoria, 'masculino');
      const totalJugadores = jugadores.length;
      
      resultado.masculino[categoria] = {
        equipos: Object.entries(equipos).map(([letra, jugadoresEquipo]) => ({
          nombre: `Equipo ${letra}`,
          jugadores: jugadoresEquipo,
          total: jugadoresEquipo.length
        })),
        totalJugadores: totalJugadores
      };
    }
  });
  
  // Procesar sección femenina
  Object.entries(data.femenino).forEach(([categoria, jugadoras]) => {
    if (Array.isArray(jugadoras)) {
      const equipos = agruparEnEquipos(jugadoras, categoria, 'femenino');
      const totalJugadoras = jugadoras.length;
      
      resultado.femenino[categoria] = {
        equipos: Object.entries(equipos).map(([letra, jugadorasEquipo]) => ({
          nombre: `Equipo ${letra}`,
          jugadores: jugadorasEquipo,
          total: jugadorasEquipo.length
        })),
        totalJugadoras: totalJugadoras
      };
    }
  });
  
  return resultado;
};

const categoriasConEquipos = procesarCategorias(playersData);

