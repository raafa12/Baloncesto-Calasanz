// Definir tipos
type CategoriaStats = {
  baby: number;
  masculino: number;
  femenino: number;
};

type Stats = {
  total: number;
  baby: number;
  masculino: number;
  femenino: number;
  categorias: {
    [key: string]: CategoriaStats;
  };
};

// Calcular estadísticas
const stats: Stats = {
  total: 2,
  baby: 0,
  masculino: 1,
  femenino: 1,
  categorias: {}
};

// Función para contar jugadores en un grupo
const contarJugadores = (grupo: Jugador[] | GrupoJugadores): number => {
  if (Array.isArray(grupo)) {
    return grupo.length;
  } else if (typeof grupo === 'object' && grupo !== null) {
    return (grupo.niños?.length || 0) + (grupo.niñas?.length || 0);
  }
  return 0;
};

// Procesar estadísticas
Object.entries(playersData).forEach(([genero, categorias]) => {
  Object.entries(categorias).forEach(([categoria, jugadores]) => {
    const totalJugadores = contarJugadores(jugadores);
    stats.total += totalJugadores;
    
    if (genero === 'baby' || genero === 'masculino' || genero === 'femenino') {
      (stats[genero as keyof Omit<Stats, 'total' | 'categorias'>] as number) += totalJugadores;
    }
    
    if (!stats.categorias[categoria]) {
      stats.categorias[categoria] = { baby: 0, masculino: 0, femenino: 0 };
    }
    
    if (genero === 'baby' || genero === 'masculino' || genero === 'femenino') {
      stats.categorias[categoria][genero as keyof CategoriaStats] = totalJugadores;
    }
  });
});

