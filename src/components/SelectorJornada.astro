---
const { jornadas = [] } = Astro.props;

const url = new URL(Astro.request.url);
const jornadaActual = url.searchParams.get("jornada") || "ultima";

// Función para formatear la fecha en formato DD/MM/YYYY
const formatearFecha = (fechaStr) => {
  try {
    // Si la fecha está en formato DD/MM/YYYY, JavaScript puede interpretarlo correctamente
    const [dia, mes, año] = fechaStr.split('-');
    const fecha = new Date(`${año}-${mes}-${dia}`); // Reordenamos a formato YYYY-MM-DD
    return fecha.toLocaleDateString('es-ES', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    });
  } catch {
    return fechaStr;
  }
};
---

<div class="selector-jornada">
  <h3 class="text-lg font-semibold text-white mb-4 flex items-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    Seleccionar Jornada:
  </h3>

  <div class="relative">
    <select
      id="jornada-selector"
      class="w-full bg-green-900 text-white border border-green-700 rounded-lg py-3 px-4 appearance-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-green-500 transition-all duration-300 hover:bg-green-800"
    >
      {jornadas.map((jornada) => {
        const esAmistoso = jornada.info.tipo?.toLowerCase().includes('amistoso');
        const textoOpcion = esAmistoso
          ? `Amistosos semana del ${formatearFecha(jornada.info.fechaInicio)}`
          : `Jornada ${jornada.info.numero}`;
          
        return (
          <option 
            value={jornada.info.numero}
            selected={String(jornadaActual) === String(jornada.info.numero)}
            data-es-amistoso={esAmistoso}
          >
            {textoOpcion}
          </option>
        );
      })}
    </select>

    <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none">
      <svg class="w-5 h-5 text-green-300" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const selector = document.getElementById('jornada-selector');
    
    selector.addEventListener('change', function () {
      const selected = this.value;
      const params = new URLSearchParams(window.location.search);
      params.set('jornada', selected);
      window.location.search = params.toString();
    });
  });
</script>





