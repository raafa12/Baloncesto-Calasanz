---
import InstagramIcon from "../../assets/icons/Instagram.astro";
import TwitterIcon from "../../assets/icons/Twitter.astro";
import MailIcon from "../../assets/icons/Mail.astro";
import PhoneIcon from "../../assets/icons/Phone.astro";
import SocialPill from "../../components/common/SocialPill.astro";
---

<div class="relative overflow-hidden">
  <!-- Fondo con patrón de balones de baloncesto estilizados -->
  <div class="absolute inset-0 bg-green-900 bg-opacity-90"></div>
  <div class="absolute inset-0 bg-[url('/images/pattern.png')] opacity-5"></div>
  
  <!-- Líneas decorativas inspiradas en la cancha de baloncesto -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-green-600"></div>
  <div class="absolute top-[50%] left-0 w-full h-px bg-white/10"></div>
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-green-600"></div>

  <div class="max-w-6xl mx-auto relative z-10 px-4 py-12 sm:py-20">
    <!-- Hero principal con diseño inspirado en Euroleague -->
    <div class="flex flex-col md:flex-row gap-8 items-center">
      <!-- Logo y título -->
      <div class="text-center md:text-left md:w-1/2">
        <div class="inline-flex items-center px-3 py-1 rounded-full bg-green-600 text-white text-xs font-bold mb-6 uppercase tracking-wider">
          <span class="mr-2 h-2 w-2 rounded-full bg-white"></span>
          Temporada 2024-2025
        </div>
        
        <div class="flex flex-col md:flex-row items-center gap-4 mb-6">
          <img 
            src="/images/LogoCalasanz.png" 
            alt="Logo Club Baloncesto Calasanz" 
            class="w-24 h-24 object-contain bg-white rounded-full p-2 shadow-xl"
          />
          <div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-2 uppercase">
              <span class="text-green-400">CALASANZ</span>
            </h1>
            <p class="text-xl text-white/80 font-medium">Club de Baloncesto</p>
          </div>
        </div>
        
        <p class="text-xl text-gray-300 max-w-xl mb-8 md:pr-6">
          <span class="text-green-400 font-semibold">+50 años</span> formando personas a través del deporte en Santander
        </p>
        
        <div class="flex flex-wrap gap-4 justify-center md:justify-start">
          <a href="/teams" class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-bold rounded-none transition-all shadow-lg uppercase tracking-wider flex items-center gap-2 border-b-4 border-green-800">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            Equipos
          </a>
          <a href="/resultados" class="px-6 py-3 bg-transparent hover:bg-white/10 text-white border-2 border-white font-bold rounded-none transition-all uppercase tracking-wider">
            Resultados
          </a>
        </div>
      </div>
      
      <!-- Imagen destacada con estilo de tarjeta de jugador -->
      <div class="relative mt-8 md:mt-0 md:w-1/2">
        <div class="relative overflow-hidden border-4 border-green-600 shadow-2xl">
          <img 
            src="/images/BanquilloFem.jpeg" 
            alt="Equipo de baloncesto Calasanz" 
            class="w-full h-[400px] object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-green-950 via-green-900/50 to-transparent"></div>
          
          <!-- Etiqueta de equipo estilo Euroleague -->
          <div class="absolute top-0 right-0 bg-green-600 text-white px-4 py-2 font-bold uppercase tracking-wider">
            Temporada 24/25
          </div>
          
          <!-- Información del equipo -->
          <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-green-950 to-transparent">
            <div class="flex items-center gap-3 mb-2">
              <div class="bg-white h-12 w-1 mr-2"></div>
              <div>
                <h3 class="text-white font-bold text-2xl uppercase">CALASANZ</h3>
                <p class="text-gray-300 text-sm uppercase tracking-wider">Santander · Cantabria</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
      
      <!-- Sección de botones de navegación -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8 mb-12">
        <!-- Botón de Equipos -->
        <div class="relative overflow-hidden rounded-xl shadow-2xl group transition-all duration-300 transform hover:scale-[1.01]">
          <a href="/teams" class="block">
            <img
              class="w-full h-48 object-cover transition-transform duration-700 group-hover:scale-105"
              src="/images/BanquilloFem.jpeg"
              alt="Equipo femenino de baloncesto Calasanz"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white transform translate-y-2 transition-transform duration-300 group-hover:translate-y-0">
              <h3 class="text-xl sm:text-2xl font-bold mb-1 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                Equipos
              </h3>
              <div class="h-0.5 w-12 bg-green-500 mb-2"></div>
              <p class="text-gray-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                Conoce a nuestros jugadores y categorías
              </p>
            </div>
          </a>
        </div>
        
        <!-- Botón de Resultados -->
        <div class="relative overflow-hidden rounded-xl shadow-2xl group transition-all duration-300 transform hover:scale-[1.01]">
          <a href="/resultados" class="block">
            <img
              class="w-full h-48 object-cover transition-transform duration-700 group-hover:scale-105"
              src="/images/DaniDiez.JPG"
              alt="Partido de baloncesto Calasanz"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white transform translate-y-2 transition-transform duration-300 group-hover:translate-y-0">
              <h3 class="text-xl sm:text-2xl font-bold mb-1 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                Resultados
              </h3>
              <div class="h-0.5 w-12 bg-green-500 mb-2"></div>
              <p class="text-gray-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                Consulta los últimos partidos y clasificaciones
              </p>
            </div>
          </a>
        </div>
      </div>
      
      <!-- Redes sociales y contacto -->
      <div class="mt-10 pt-6 border-t border-white/10">
        <p class="text-gray-400 text-sm mb-4 text-center">Conéctate con nosotros</p>
        <div class="flex flex-wrap justify-center gap-4">
          <SocialPill href="mailto:clubdeportivocalasanzsantander@hotmail.com">
            <MailIcon class="size-4" />
            Escríbenos
          </SocialPill>
          <SocialPill href="tel:606134150">
            <PhoneIcon class="size-4" />
            Llámanos
          </SocialPill>
          <SocialPill href="https://www.instagram.com/cbcalasanz/">
            <InstagramIcon class="size-4" />
            Instagram
          </SocialPill>
          <SocialPill href="https://x.com/cbcalasanz?lang=es">
            <TwitterIcon class="size-4" />
            Twitter
          </SocialPill>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
  
  .animate-blob {
    animation: blob 7s infinite;
  }
  
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  
  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>