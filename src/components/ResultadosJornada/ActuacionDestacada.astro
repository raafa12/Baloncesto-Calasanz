---
// Importamos los datos de los equipos
import equiposMasculinos from '../../data/equiposMasculinos.json';

const { jugadorNombre, equipo, seccion = "masculina", comentario } = Astro.props;

// Función para buscar un jugador por nombre en los equipos
function buscarJugador(nombre, seccion) {
  // Seleccionamos el conjunto de equipos según la sección
  const equipos = seccion === "masculina" ? equiposMasculinos : equiposFemeninos;
  
  // Buscamos en todos los equipos
  for (const equipoData of equipos) {
    // Primero buscamos en miembros (jugadores)
    const jugador = equipoData.miembros?.find(
      miembro => miembro.nombre.toLowerCase() === nombre.toLowerCase()
    );
    
    if (jugador) {
      return { 
        ...jugador,
        equipo: equipoData.nombre
      };
    }
    
    // Si no se encuentra, también buscamos en entrenadores
    const entrenador = equipoData.entrenadores?.find(
      entrenador => entrenador.nombre.toLowerCase() === nombre.toLowerCase()
    );
    
    if (entrenador) {
      return { 
        ...entrenador,
        equipo: equipoData.nombre
      };
    }
  }
  
  // Si no se encuentra, devolvemos un objeto con datos mínimos
  return { 
    nombre: nombre,
    foto: "/api/placeholder/150/150",
    equipo: equipo || "Equipo no especificado"
  };
}

// Buscar al jugador en los datos
const jugador = buscarJugador(jugadorNombre, seccion);
---

<div class="bg-gradient-to-r from-green-900 to-green-800 bg-opacity-30 rounded-lg p-4 mt-6 border-l-4 border-green-500">
  <h3 class="text-green-400 font-semibold mb-2 flex items-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
    </svg>
    Actuación Destacada
  </h3>
  
  <div class="flex flex-col sm:flex-row items-center">
    <div class="flex-shrink-0 mb-3 sm:mb-0">
      <div class="relative">
        <img 
          src={jugador.foto} 
          alt={`Foto de ${jugador.nombre}`} 
          class="w-20 h-20 sm:w-24 sm:h-24 object-cover rounded-full border-2 border-green-500 shadow-lg"
          onerror="this.src='/images/placeholder-player.png'"
        />
        <div class="absolute -bottom-1 -right-1 bg-green-500 text-white rounded-full p-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        </div>
      </div>
    </div>
    
    <div class="ml-0 sm:ml-6 text-center sm:text-left">
      <h4 class="text-white text-lg font-medium">{jugador.nombre}</h4>
      
      {comentario && (
        <div class="mt-2">
          <p class="text-gray-200 italic relative">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-400 inline mr-1" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.51.88-3.995 3.356-3.995 5.849h4v10h-10zm-10 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.511.88-3.996 3.356-3.996 5.849h4v10h-10z"/>
            </svg>
            {comentario}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-400 inline ml-1" fill="currentColor" viewBox="0 0 24 24" style="transform: rotate(180deg);">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.51.88-3.995 3.356-3.995 5.849h4v10h-10zm-10 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.511.88-3.996 3.356-3.996 5.849h4v10h-10z"/>
            </svg>
          </p>
        </div>
      )}
    </div>
  </div>
</div>