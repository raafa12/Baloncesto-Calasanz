---
import ActuacionDestacada from './ActuacionDestacada.astro';

const { resultado, seccion = "masculina" } = Astro.props;
const {
  categoria,
  local,
  visitante,
  puntosLocal,
  puntosVisitante,
  fecha,
  hora,
  lugar,
  jugadorDestacado,
  comentarioJugador
} = resultado;

// Determinar si es victoria, derrota o no jugado
let estado = "";
let claseEstado = "";

if (puntosLocal !== null && puntosVisitante !== null) {
  const esCalasanzLocal = local.toLowerCase().includes('calasanz');
  const puntosCalasanz = esCalasanzLocal ? puntosLocal : puntosVisitante;
  const puntosRival = esCalasanzLocal ? puntosVisitante : puntosLocal;
  
  if (puntosCalasanz > puntosRival) {
    estado = "VICTORIA";
    claseEstado = "bg-green-700";
  } else if (puntosCalasanz < puntosRival) {
    estado = "DERROTA";
    claseEstado = "bg-red-700";
  } else if (puntosCalasanz === puntosRival) {
    estado = "EMPATE";
    claseEstado = "bg-yellow-700";
  }
} else {
  estado = "NO JUGADO";
  claseEstado = "bg-gray-700";
}
---

<div class="bg-green-950 rounded-lg overflow-hidden shadow-lg">
  <div class="p-4">
    <div class="flex justify-between items-center mb-3">
      <h3 class="text-xl font-bold text-white">{categoria}</h3>
      <div class={`${claseEstado} px-3 py-1 rounded text-white text-sm font-medium`}>
        {estado}
      </div>
    </div>
    
    <!-- Equipos y resultado -->
    <div class="flex justify-between items-center bg-green-900 bg-opacity-30 p-3 rounded">
      <div class="flex-1 text-left">
        <p class={`font-semibold ${local.toLowerCase().includes('calasanz') ? 'text-green-400' : 'text-white'}`}>
          {local}
        </p>
      </div>
      
      <div class="px-4 flex justify-center items-center">
        {puntosLocal !== null && puntosVisitante !== null ? (
          <div class="text-xl font-bold text-white">
            {puntosLocal} - {puntosVisitante}
          </div>
        ) : (
          <div class="text-sm font-medium text-gray-400">
            {fecha && hora ? `${fecha} - ${hora}` : 'Por determinar'}
          </div>
        )}
      </div>
      
      <div class="flex-1 text-right">
        <p class={`font-semibold ${visitante.toLowerCase().includes('calasanz') ? 'text-green-400' : 'text-white'}`}>
          {visitante}
        </p>
      </div>
    </div>
    
    <!-- Información adicional -->
    {(fecha || hora || lugar) && (
      <div class="mt-3 text-sm text-gray-300">
        {fecha && <span class="mr-3">{fecha}</span>}
        {hora && <span class="mr-3">{hora}</span>}
        {lugar && <span>{lugar}</span>}
      </div>
    )}
    
    <!-- Jugador destacado si existe -->
    {jugadorDestacado && (
      <ActuacionDestacada 
        jugadorNombre={jugadorDestacado} 
        equipo={categoria}
        seccion={seccion}
        comentario={comentarioJugador} 
      />
    )}
  </div>
</div>