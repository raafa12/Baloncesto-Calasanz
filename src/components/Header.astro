---
const navItems = [
  {
    title: "Inicio",
    label: "inicio",
    url: "/",
  },
  {
    title: "Equipos",
    label: "equipos",
    url: "/teams",
  },
  {
    title: "Resultados",
    label: "resultados",
    url: "/resultados",
  },
  {
    title: "Noticias",
    label: "news",
    url: "/news",
  },
  {
    title: "Contacto",
    label: "contact",
    url: "/contact",
  },
]
---

<header class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-1">
  <nav class="flex px-2 py-1 text-xs sm:text-sm font-medium rounded-full text-gray-100 justify-center items-center transition-all duration-300 shadow-md">
    {
      navItems.map((link) => (
        <a
          class="relative block px-1 sm:px-2 py-1 transition hover:text-green-300"
          aria-label={link.label}
          href={link.url}
          data-nav-link={link.label}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");
    
    // Get current path but handle special cases
    let currentPath = window.location.pathname;
    
    // Remove trailing slash if present (except for root path)
    if (currentPath !== "/" && currentPath.endsWith("/")) {
      currentPath = currentPath.slice(0, -1);
    }
    
    // Handle root path special case
    if (currentPath === "" || currentPath === "/") {
      // We're on the homepage
      const homeLink = document.querySelector('[data-nav-link="inicio"]');
      if (homeLink) {
        homeLink.classList.add("text-green-300", "font-bold", "active-nav-item");
      }
    } else {
      // We're on another page - loop through nav items and find the best match
      let bestMatch = null;
      let bestMatchLength = 0;
      
      navItems.forEach((item) => {
        const itemUrl = item.getAttribute("href");
        // Skip the homepage link when checking other pages
        if (itemUrl === "/" && currentPath !== "/") return;
        
        // Clean the URL for comparison
        let cleanItemUrl = itemUrl;
        if (cleanItemUrl.endsWith("/")) {
          cleanItemUrl = cleanItemUrl.slice(0, -1);
        }
        // Special case for homepage
        if (cleanItemUrl === "") cleanItemUrl = "/";
        
        // Check if this path is part of the current URL
        if (currentPath.includes(cleanItemUrl) && cleanItemUrl.length > bestMatchLength) {
          bestMatch = item;
          bestMatchLength = cleanItemUrl.length;
        }
      });
      
      // Apply active class to the best matching item
      if (bestMatch) {
        bestMatch.classList.add("text-green-300", "font-bold", "active-nav-item");
      }
    }

    // Section observation for scrolling - this works for within-page sections
    const callback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const sectionId = entry.target.id;
          
          navItems.forEach((item) => {
            // Only apply this logic if we're on the homepage or a page with sections
            if (currentPath === "/" || currentPath === "") {
              if (item.getAttribute("aria-label") === sectionId) {
                item.classList.add("text-green-300", "font-bold", "active-nav-item");
              } else {
                item.classList.remove("text-green-300", "font-bold", "active-nav-item");
              }
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        sections.forEach((section) => {
          observer.observe(section);
        });
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadow 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
    background-color: rgba(20, 83, 45, 0.85); /* Color más claro similar al fondo de la página */
    backdrop-filter: blur(5px);
    border: 1px solid rgba(50, 200, 100, 0.2); /* Using the same green from the gradient */
    max-width: 95%;
  }

  .dark nav {
    background-color: rgba(20, 83, 45, 0.85); /* Mismo color más claro */
    border: 1px solid rgba(50, 200, 100, 0.2);
  }

  /* Active indicator - smaller for mobile */
  .active-nav-item {
    position: relative;
  }
  
  .active-nav-item::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    height: 2px;
    background-color: rgba(50, 200, 100, 0.8); /* Using a green from the same palette */
    border-radius: 1px;
    animation: fade 0.3s ease-in-out;
  }

  /* Mobile-optimized hover effects */
  nav a {
    position: relative;
    transition: all 0.2s ease;
  }
  
  @media (hover: hover) {
    nav a:hover {
      color: rgba(50, 200, 100, 0.9); /* Slightly brighter version of the same green */
    }
  }

  .dark nav a:hover {
    color: rgba(50, 200, 100, 0.9);
  }

  /* Ensure text doesn't wrap on small screens */
  @media (max-width: 640px) {
    nav {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
    
    nav a {
      padding-left: 0.35rem;
      padding-right: 0.35rem;
      white-space: nowrap;
      font-size: 0.7rem;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
      width: 0;
    }
    to {
      opacity: 1;
      width: 40%;
    }
  }
  
  @keyframes nav-shadow {
    from {
      box-shadow: 0 0 0 rgba(5, 46, 22, 0);
    }
    to {
      box-shadow: 0 2px 10px rgba(5, 46, 22, 0.5);
    }
  }
</style>