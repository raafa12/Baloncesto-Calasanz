---
import Badge from "../components/Badge.astro";
import InstagramIcon from "../assets/Instagram.astro";
import TwitterIcon from "../assets/Twitter.astro";
import MailIcon from "../assets/Mail.astro";
import PhoneIcon from "../assets/Phone.astro";
import SocialPill from "../components/SocialPill.astro";
---

<div class="relative overflow-hidden">
  <!-- Círculos decorativos en el fondo -->
  <div class="absolute top-20 left-10 w-64 h-64 bg-green-500 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob"></div>
  <div class="absolute top-10 right-10 w-72 h-72 bg-green-300 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob animation-delay-2000"></div>
  <div class="absolute -bottom-8 left-20 w-72 h-72 bg-green-600 rounded-full mix-blend-multiply filter blur-3xl opacity-10 animate-blob animation-delay-4000"></div>

  <div class="max-w-5xl mx-auto relative z-10 px-4 py-16 sm:py-24">
    <!-- Contenedor principal con efecto de vidrio -->
    <div class="backdrop-blur-sm bg-white/5 border border-white/10 rounded-2xl shadow-2xl p-8 sm:p-12">
      <!-- Sección superior con logo y título -->
      <div class="flex flex-col items-center text-center mb-12">
        <div class="relative inline-block mb-6">
          <div class="absolute inset-0 bg-green-500 blur-xl opacity-30 rounded-full animate-pulse"></div>
          <img
            class="relative rounded-full shadow-lg size-28 sm:size-32 ring-2 ring-green-500/70"
            src="/images/LogoCalasanz.png"
            alt="Logo Club Baloncesto Calasanz"
          />
        </div>
        
        <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl md:text-5xl">
          Club Baloncesto <span class="bg-clip-text text-transparent bg-gradient-to-r from-green-400 to-green-100">Calasanz</span>
        </h1>
        
        <p class="mt-4 text-xl text-gray-300 max-w-xl">
          <span class="text-green-400 font-semibold">+50 años</span> formando personas a través del deporte
        </p>
      </div>
      
      <!-- Sección de botones de navegación -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8 mb-12">
        <!-- Botón de Equipos -->
        <div class="relative overflow-hidden rounded-xl shadow-2xl group transition-all duration-300 transform hover:scale-[1.01]">
          <a href="/teams" class="block">
            <img
              class="w-full h-48 object-cover transition-transform duration-700 group-hover:scale-105"
              src="/images/BanquilloFem.jpeg"
              alt="Equipo femenino de baloncesto Calasanz"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white transform translate-y-2 transition-transform duration-300 group-hover:translate-y-0">
              <h3 class="text-xl sm:text-2xl font-bold mb-1 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                Equipos
              </h3>
              <div class="h-0.5 w-12 bg-green-500 mb-2"></div>
              <p class="text-gray-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                Conoce a nuestros jugadores y categorías
              </p>
            </div>
          </a>
        </div>
        
        <!-- Botón de Resultados -->
        <div class="relative overflow-hidden rounded-xl shadow-2xl group transition-all duration-300 transform hover:scale-[1.01]">
          <a href="/results" class="block">
            <img
              class="w-full h-48 object-cover transition-transform duration-700 group-hover:scale-105"
              src="/images/DaniDiez.JPG"
              alt="Partido de baloncesto Calasanz"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white transform translate-y-2 transition-transform duration-300 group-hover:translate-y-0">
              <h3 class="text-xl sm:text-2xl font-bold mb-1 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                Resultados
              </h3>
              <div class="h-0.5 w-12 bg-green-500 mb-2"></div>
              <p class="text-gray-300 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                Consulta los últimos partidos y clasificaciones
              </p>
            </div>
          </a>
        </div>
      </div>
      
      <!-- Redes sociales y contacto -->
      <div class="mt-10 pt-6 border-t border-white/10">
        <p class="text-gray-400 text-sm mb-4 text-center">Conéctate con nosotros</p>
        <div class="flex flex-wrap justify-center gap-4">
          <SocialPill href="mailto:clubdeportivocalasanzsantander@hotmail.com">
            <MailIcon class="size-4" />
            Escríbenos
          </SocialPill>
          <SocialPill href="tel:606134150">
            <PhoneIcon class="size-4" />
            Llámanos
          </SocialPill>
          <SocialPill href="https://www.instagram.com/cbcalasanz/">
            <InstagramIcon class="size-4" />
            Instagram
          </SocialPill>
          <SocialPill href="https://x.com/cbcalasanz?lang=es">
            <TwitterIcon class="size-4" />
            Twitter
          </SocialPill>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
  
  .animate-blob {
    animation: blob 7s infinite;
  }
  
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  
  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>