---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import AboutMe from "../components/home/AboutMe.astro";
import Hero from "../components/home/Hero.astro";
import SectionContainer from "../components/common/SectionContainer.astro";
import TitleSection from "../components/common/TitleSection.astro";
import FeatureCard from "../components/common/FeatureCard.astro";
import TeamIcon from "../assets/Teams.astro";
import CalendarIcon from "../assets/Calendar.astro";
import NewsIcon from "../assets/News.astro";
---

<Layout
  title="Club Baloncesto Calasanz"
  description="Club de baloncesto con más de 50 años formando personas a través del deporte en el Colegio Calasanz-Escolapios de Santander."
>
  <main class="px-4 bg-green-950">
    <!-- Hero Section -->
    <SectionContainer class="pt-36 pb-2 md:pb-4 bg-green-950 border-t-2 border-green-700">
      <Hero />
    </SectionContainer>

    <!-- Features Section -->
    <SectionContainer class="py-4 md:py-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10">
        <!-- Equipos Feature Card -->
        <FeatureCard 
          title="Nuestros Equipos" 
          href="/teams" 
          imageSrc="/images/BanquilloFem.jpeg"
          imageAlt="Equipo femenino de baloncesto Calasanz"
          icon={TeamIcon}
        >
          Conoce a nuestros jugadores y categorías desde Benjamín hasta Senior. 
          Descubre los valores que compartimos y la familia que formamos.
        </FeatureCard>

        <!-- Resultados Feature Card -->
        <FeatureCard 
          title="Resultados y Clasificación" 
          href="/results" 
          imageSrc="https://conviveyestudia.org/wp-content/uploads/2020/04/campo-colegio-calasanz-santander.jpg"
          imageAlt="Cancha de baloncesto del Colegio Calasanz"
          icon={CalendarIcon}
        >
          Consulta los últimos resultados, la clasificación actualizada y los próximos 
          partidos de todos nuestros equipos.
        </FeatureCard>
      </div>
    </SectionContainer>

    <!-- Sobre Nosotros Section -->
    <SectionContainer id="sobre-nosotros" class="pt-2 pb-4 md:pb-8 bg-green-950">
      <TitleSection>
        <TeamIcon class="size-8" />
        Sobre nosotros
      </TitleSection>
      <AboutMe />
    </SectionContainer>

    <!-- Últimas Noticias Section -->
    <SectionContainer id="noticias" class="py-4 md:py-8 bg-green-950">
      <div class="max-w-6xl mx-auto">
        <div class="flex justify-between items-center mb-8">
          <TitleSection>
            <NewsIcon class="size-8" />
            Últimas Noticias
          </TitleSection>
          <a href="/noticias" class="text-green-400 hover:text-green-300 font-medium flex items-center gap-2 transition-colors">
            Ver todas las noticias
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
        
        <div class="grid grid-cols-1 gap-6">
          <!-- Noticia de Jornadas de Tecnificación -->
          <div class="bg-green-900/50 rounded-2xl overflow-hidden shadow-lg border border-green-800/30 hover:border-green-500/40 transition-all duration-300 group">
            <div class="h-full flex flex-col md:flex-row">
              <div class="w-full md:w-1/3 h-48 md:h-auto relative overflow-hidden">
                <img 
                  src="/images/basket.JPEG" 
                  alt="Jornadas de tecnificación" 
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  style="object-position: center 30%;"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-green-950/80 to-transparent md:bg-gradient-to-r md:from-green-950/80 md:to-transparent"></div>
              </div>
              
              <div class="p-6 flex-1 flex flex-col">
                <h3 class="text-white font-bold text-xl md:text-2xl mb-3 group-hover:text-green-300 transition-colors">Jornadas de Tecnificación 2025</h3>
                
                <p class="text-gray-300 text-sm md:text-base mb-4">No pierdas la oportunidad de formar parte de nuestras jornadas de tecnificación. Mejora tus habilidades con nuestros entrenadores cualificados en un entorno de aprendizaje único.</p>
                
                <div class="mt-auto">
                  <a href="/noticias/jornadas-tecnificacion" class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 rounded-lg text-white font-medium transition-all duration-300">
                    <span>Leer más</span>
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>
      
      <div class="flex justify-center mt-8">
        <a href="/news" class="inline-flex items-center gap-2 px-6 py-3 bg-green-500/20 hover:bg-green-500/40 rounded-full text-green-400 font-medium transition-all duration-300 group">
          <span>Ver todas las noticias</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </SectionContainer>
  </main>
</Layout>