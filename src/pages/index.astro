---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import AboutMe from "../components/AboutMe.astro";
import Hero from "../components/Hero.astro";
import SectionContainer from "../components/SectionContainer.astro";
import TitleSection from "../components/TitleSection.astro";
import TeamIcon from "../assets/Teams.astro";
import CalendarIcon from "../assets/Calendar.astro";
import NewsIcon from "../assets/News.astro";
import FeatureCard from "../components/FeatureCard.astro";
---

<Layout
  title="Club Baloncesto Calasanz"
  description="Club de baloncesto con más de 50 años formando personas a través del deporte en el Colegio Calasanz-Escolapios de Santander."
>
  <main class="px-4">
    <!-- Hero Section -->
    <SectionContainer class="py-12 md:py-24">
      <Hero />
    </SectionContainer>

    <!-- Features Section -->
    <SectionContainer class="py-8 md:py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10">
        <!-- Equipos Feature Card -->
        <FeatureCard 
          title="Nuestros Equipos" 
          href="/teams" 
          imageSrc="/images/BanquilloFem.jpeg"
          imageAlt="Equipo femenino de baloncesto Calasanz"
          icon={TeamIcon}
        >
          Conoce a nuestros jugadores y categorías desde Benjamín hasta Senior. 
          Descubre los valores que compartimos y la familia que formamos.
        </FeatureCard>

        <!-- Resultados Feature Card -->
        <FeatureCard 
          title="Resultados y Clasificación" 
          href="/results" 
          imageSrc="https://conviveyestudia.org/wp-content/uploads/2020/04/campo-colegio-calasanz-santander.jpg"
          imageAlt="Cancha de baloncesto del Colegio Calasanz"
          icon={CalendarIcon}
        >
          Consulta los últimos resultados, la clasificación actualizada y los próximos 
          partidos de todos nuestros equipos.
        </FeatureCard>
      </div>
    </SectionContainer>

    <!-- Sobre Nosotros Section -->
    <SectionContainer id="sobre-nosotros" class="pt-2 pb-8 md:pb-16">
      <TitleSection>
        <TeamIcon class="size-8" />
        Sobre nosotros
      </TitleSection>
      <AboutMe />
    </SectionContainer>

    <!-- Últimas Noticias Section -->
    <SectionContainer id="noticias" class="py-8 md:py-16">
      <TitleSection>
        <NewsIcon class="size-8" />
        Últimas Noticias
      </TitleSection>
      
      <div class="mt-8">
        <div class="bg-gray-800/50 rounded-xl p-6 border border-green-500/20 hover:border-green-500/40 transition-all duration-300 hover:bg-gray-800/70">
          <p class="text-green-400 text-sm mb-2">10 Abril, 2025</p>
          <h3 class="text-white font-bold text-xl mb-2">Campus de verano 2025: ¡Inscríbete ya!</h3>
          <p class="text-gray-300 mb-4">Ya están abiertas las inscripciones para nuestro campus de verano. Plazas limitadas.</p>
          <a href="/news/campus-verano" class="text-green-400 hover:text-green-300 font-medium">Leer más →</a>
        </div>
      </div>
      
      <div class="flex justify-center mt-8">
        <a href="/news" class="px-6 py-3 bg-green-500/20 hover:bg-green-500/40 rounded-full text-green-400 font-medium transition-all duration-300">Ver todas las noticias</a>
      </div>
    </SectionContainer>
  </main>
</Layout>