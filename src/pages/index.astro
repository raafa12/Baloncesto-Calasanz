---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import AboutMe from "../components/home/AboutMe.astro";
import Hero from "../components/home/Hero.astro";
import SectionContainer from "../components/common/SectionContainer.astro";
import TitleSection from "../components/common/TitleSection.astro";
import FeatureCard from "../components/common/FeatureCard.astro";
import TeamIcon from "../assets/Teams.astro";
import CalendarIcon from "../assets/Calendar.astro";
import NewsIcon from "../assets/News.astro";
---

<Layout
  title="Club Baloncesto Calasanz"
  description="Club de baloncesto con más de 50 años formando personas a través del deporte en el Colegio Calasanz-Escolapios de Santander."
>
  <main class="px-4">
    <!-- Hero Section -->
    <SectionContainer class="pt-6 pb-1 md:pb-4">
      <Hero />
    </SectionContainer>

    <!-- Features Section -->
    <SectionContainer class="py-6 md:py-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10">
        <!-- Equipos Feature Card -->
        <FeatureCard 
          title="Nuestros Equipos" 
          href="/teams" 
          imageSrc="/images/BanquilloFem.jpeg"
          imageAlt="Equipo femenino de baloncesto Calasanz"
          icon={TeamIcon}
        >
          Conoce a nuestros jugadores y categorías desde Benjamín hasta Senior. 
          Descubre los valores que compartimos y la familia que formamos.
        </FeatureCard>

        <!-- Resultados Feature Card -->
        <FeatureCard 
          title="Resultados y Clasificación" 
          href="/results" 
          imageSrc="https://conviveyestudia.org/wp-content/uploads/2020/04/campo-colegio-calasanz-santander.jpg"
          imageAlt="Cancha de baloncesto del Colegio Calasanz"
          icon={CalendarIcon}
        >
          Consulta los últimos resultados, la clasificación actualizada y los próximos 
          partidos de todos nuestros equipos.
        </FeatureCard>
      </div>
    </SectionContainer>

    <!-- Sobre Nosotros Section -->
    <SectionContainer id="sobre-nosotros" class="pt-2 pb-6 md:pb-12">
      <TitleSection>
        <TeamIcon class="size-8" />
        Sobre nosotros
      </TitleSection>
      <AboutMe />
    </SectionContainer>

    <!-- Últimas Noticias Section -->
    <SectionContainer id="noticias" class="py-6 md:py-12">
      <TitleSection>
        <NewsIcon class="size-8" />
        Últimas Noticias
      </TitleSection>
      
      <div class="mt-8">
        <div class="bg-green-800 bg-opacity-10 rounded-2xl p-8 border border-green-500/20 hover:border-green-500/40 transition-all duration-300 hover:bg-green-800/20 group">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0">
              <span class="inline-flex items-center justify-center h-12 w-12 rounded-full bg-green-500">
                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-green-400 text-sm font-medium mb-1">10 Abril, 2025</p>
              <h3 class="text-white font-bold text-2xl mb-2">Campus de verano 2025: ¡Inscríbete ya!</h3>
              <p class="text-gray-400 text-sm mb-4">Ya están abiertas las inscripciones para nuestro campus de verano. Plazas limitadas.</p>
              <a href="/news/campus-verano" class="inline-flex items-center gap-2 text-green-400 hover:text-green-300 font-medium group-hover:text-white transition-colors">
                <span>Leer más</span>
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <div class="flex justify-center mt-8">
        <a href="/news" class="inline-flex items-center gap-2 px-6 py-3 bg-green-500/20 hover:bg-green-500/40 rounded-full text-green-400 font-medium transition-all duration-300 group">
          <span>Ver todas las noticias</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </SectionContainer>
  </main>
</Layout>