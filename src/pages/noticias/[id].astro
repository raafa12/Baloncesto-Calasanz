---
import Layout from '../../layouts/Layout.astro';
import SectionContainer from "../../components/common/SectionContainer.astro";
import NewsForm from "../../components/news/NewsForm.astro";

// Lista de noticias (solo queda una)
const noticias = [
  {
    id: "campus-verano",
    titulo: 'Campus de verano 2025: ¡Inscríbete ya!',
    descripcion: 'Ya están abiertas las inscripciones para nuestro campus de verano. Plazas limitadas. Aprende con los mejores entrenadores y disfruta de un verano lleno de baloncesto.',
    contenido: `
      ¡Bienvenidos al Campus de Verano 2025! Este año, del 1 al 15 de julio, el Club Baloncesto Calasanz organiza su tradicional campus dirigido a niños y jóvenes de entre 8 y 16 años. Contaremos con entrenadores profesionales y actividades especiales diseñadas para fomentar el aprendizaje, la diversión y el trabajo en equipo.

      Durante estas dos semanas, los participantes podrán disfrutar de:
      - Entrenamientos intensivos de baloncesto.
      - Talleres educativos diseñados para fomentar el crecimiento personal.
      - Actividades recreativas en un ambiente seguro y motivador.

      Además, cada jugador recibirá una evaluación personalizada y consejos para mejorar sus habilidades. ¡No te pierdas esta oportunidad única de crecer como jugador y como persona! Las plazas son limitadas, así que te recomendamos que reserves cuanto antes.
    `,
    fecha: '10 abril 2025',
    imagen: '/images/basket.JPEG',
    categoria: 'Eventos',
    formulario: true,
    tipoFormulario: 'inscripcion'
  }
];

// Función para obtener la noticia basada en el ID
const { id } = Astro.params;
const noticia = noticias.find((item) => item.id === id);

// Configuración de la página
const title = noticia ? noticia.titulo : 'Noticia no encontrada';
const description = noticia ? noticia.descripcion : 'La noticia que buscas no existe';
---
<Layout title={title} description={description}>
  <main class="container mx-auto px-6 sm:px-12 lg:px-24 py-20 sm:py-28 max-w-5xl">
    <div class="mb-8">
      <a href="/news" class="inline-flex items-center text-green-400 hover:text-green-300 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        Volver a noticias
      </a>
    </div>
    
    {noticia ? (
      <article class="bg-green-950 rounded-xl overflow-hidden shadow-lg border border-green-800/30 mx-auto max-w-4xl">
        <!-- Header de la noticia con imagen destacada -->
        <div class="relative">
          <div class="w-full h-48 sm:h-56 md:h-64 overflow-hidden">
            <img 
              src={noticia.imagen} 
              alt={noticia.titulo} 
              class="w-full h-full object-cover object-center"
              style="object-position: center 30%;"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-green-950 to-transparent"></div>
          </div>
          
          <!-- Información superpuesta -->
          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 md:p-10">
            <div class="flex items-center gap-2 mb-3">
              <span class="bg-green-600/90 text-white text-xs font-bold px-3 py-1 rounded-full">
                {noticia.categoria}
              </span>
              <span class="text-green-300 text-sm font-medium">{noticia.fecha}</span>
            </div>
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-2 leading-tight">
              {noticia.titulo}
            </h1>
          </div>
        </div>
        
        <!-- Contenido de la noticia -->
        <div class="p-6 sm:p-8 md:p-10">
          <div class="prose prose-lg prose-invert max-w-none">
            <p class="text-lg text-green-200 font-medium mb-8 border-l-4 border-green-500 pl-4">
              {noticia.descripcion}
            </p>
            
            <div class="text-gray-300 text-base sm:text-lg leading-relaxed space-y-6">
              {noticia.contenido.split('\n').map(parrafo => {
                if (parrafo.trim().startsWith('-')) {
                  // Es un elemento de lista
                  return (
                    <ul class="list-disc pl-5 space-y-2">
                      <li>{parrafo.trim().substring(1).trim()}</li>
                    </ul>
                  );
                } else if (parrafo.trim()) {
                  // Es un párrafo normal
                  return <p>{parrafo.trim()}</p>;
                }
                return null;
              })}
            </div>
          </div>
          
          <!-- Compartir en redes sociales -->
          <div class="mt-10 pt-6 border-t border-green-800/30">
            <div class="flex items-center justify-between">
              <p class="text-green-300 font-medium">Comparte esta noticia:</p>
              <div class="flex space-x-4">
                <a href="#" class="text-gray-400 hover:text-white transition-colors">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                  </svg>
                </a>
                <a href="#" class="text-gray-400 hover:text-white transition-colors">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
                  </svg>
                </a>
                <a href="#" class="text-gray-400 hover:text-white transition-colors">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
          
          <!-- Formulario de inscripción -->
          {noticia.formulario && (
            <div class="mt-12">
              <NewsForm tipoFormulario={noticia.tipoFormulario} />
            </div>
          )}
        </div>
      </article>
    ) : (
      <div class="bg-red-900/20 border border-red-500/30 rounded-xl p-8 text-center">
        <svg class="w-16 h-16 text-red-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h2 class="text-2xl font-bold text-red-400 mb-2">¡Noticia no encontrada!</h2>
        <p class="text-gray-300 mb-6">La noticia que buscas no existe o ha sido eliminada.</p>
        <a href="/news" class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 rounded-lg text-white font-medium transition-all duration-300">
          <span>Volver a noticias</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    )}
  </main>
</Layout>