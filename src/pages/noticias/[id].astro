---
import Layout from '../../layouts/Layout.astro';
import SectionContainer from "../../components/common/SectionContainer.astro";
import NewsForm from "../../components/news/NewsForm.astro";
import EquiposTemporada from "../../components/equipos/EquiposTemporada.astro";

// Lista de noticias
const noticias = [
  {
    id: "equipos-temporada-25-26",
    titulo: '¡Conoce los equipos de la temporada 25/26!',
    descripcion: 'Ya están disponibles los equipos del CB Calasanz para la próxima temporada. ¡Descubre a nuestros jugadores y jugadoras en todas las categorías!',
    contenido: `
      
    `,
    fecha: '26 junio 2025',
    imagen: '/images/BenjaKids.JPG',
    categoria: 'Equipos',
    formulario: false,
    componenteEspecial: true
  },
  {
    id: "campus-verano",
    titulo: 'Campus de verano 2025: ¡Inscríbete ya!',
    descripcion: 'Ya están abiertas las inscripciones para nuestro campus de verano. Plazas limitadas. Aprende con los mejores entrenadores y disfruta de un verano lleno de baloncesto.',
    contenido: `
      ¡Bienvenidos al Campus de Verano 2025! Este año, del 1 al 15 de julio, el Club Baloncesto Calasanz organiza su tradicional campus dirigido a niños y jóvenes de entre 8 y 16 años. Contaremos con entrenadores profesionales y actividades especiales diseñadas para fomentar el aprendizaje, la diversión y el trabajo en equipo.

      Durante estas dos semanas, los participantes podrán disfrutar de:
      - Entrenamientos intensivos de baloncesto.
      - Talleres educativos diseñados para fomentar el crecimiento personal.
      - Actividades recreativas en un ambiente seguro y motivador.

      Además, cada jugador recibirá una evaluación personalizada y consejos para mejorar sus habilidades. ¡No te pierdas esta oportunidad única de crecer como jugador y como persona! Las plazas son limitadas, así que te recomendamos que reserves cuanto antes.
    `,
    fecha: '10 abril 2025',
    imagen: '/images/basket.JPEG',
    categoria: 'Eventos',
    formulario: true,
    tipoFormulario: 'inscripcion',
    componenteEspecial: false
  }
];

// Función para obtener la noticia basada en el ID
const { id } = Astro.params;
const noticia = noticias.find((item) => item.id === id);

// Configuración de la página
const title = noticia ? noticia.titulo : 'Noticia no encontrada';
const description = noticia ? noticia.descripcion : 'La noticia que buscas no existe';
---
<Layout title={title} description={description}>
  <main class="container mx-auto px-6 sm:px-12 lg:px-24 py-20 sm:py-28 max-w-7xl">
    <div class="mb-8">
      <a href="/news" class="inline-flex items-center text-green-400 hover:text-green-300 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        Volver a noticias
      </a>
    </div>
    
    {!noticia ? (
      <div class="bg-red-900/20 border border-red-500/30 rounded-xl p-8 text-center">
        <svg class="w-16 h-16 text-red-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h2 class="text-2xl font-bold text-red-400 mb-2">¡Noticia no encontrada!</h2>
        <p class="text-gray-300 mb-6">La noticia que buscas no existe o ha sido eliminada.</p>
        <a href="/news" class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 rounded-lg text-white font-medium transition-all duration-300">
          <span>Volver a noticias</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    ) : (
      <article class="bg-green-950 rounded-xl overflow-hidden shadow-lg border border-green-800/30 mx-auto">
        <!-- Header de la noticia con imagen destacada -->
        <div class="relative">
          <div class="w-full h-48 sm:h-56 md:h-64 overflow-hidden">
            <img 
              src={noticia.imagen} 
              alt={noticia.titulo}
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-6 w-full">
              <span class="inline-block px-3 py-1 bg-green-600 text-white text-sm font-medium rounded-full mb-2">
                {noticia.categoria}
              </span>
              <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white">{noticia.titulo}</h1>
              <div class="flex items-center mt-2 text-green-200 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>{noticia.fecha}</span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Contenido de la noticia -->
        <div class="p-6 sm:p-8 md:p-10">
          <div class="prose prose-lg prose-invert max-w-none">
            <p class="text-lg text-green-200 font-medium mb-8 border-l-4 border-green-500 pl-4">
              {noticia.descripcion}
            </p>
            
            {noticia.componenteEspecial ? (
              <div>
                <div set:html={noticia.contenido} class="space-y-6"></div>
                {/* Componente especial para la noticia de equipos */}
                <div class="mt-12">
                  <EquiposTemporada client:load />
                </div>
              </div>
            ) : (
              <div set:html={noticia.contenido.replace(/\n/g, '<br />')} class="space-y-6"></div>
            )}
          </div>
          
          <!-- Formulario de inscripción -->
          {noticia.formulario && (
            <div class="mt-12">
              <NewsForm tipoFormulario={noticia.tipoFormulario} />
            </div>
          )}
        </div>
      </article>
    )}
  </main>
</Layout>