---
import Layout from '../../layouts/Layout.astro';
import SectionContainer from "../../components/common/SectionContainer.astro";
import NewsForm from "../../components/news/NewsForm.astro";
import { noticias } from '../../data/noticias';

// Obtener la noticia basada en el ID
const { id } = Astro.params;
const noticia = noticias.find((item) => item.id === id);

// Si no se encuentra la noticia, redirigir a la página 404
if (!noticia) {
  return Astro.redirect('/404');
}

// Configuración de la página con valores por defecto
const title = noticia.titulo || 'Noticia';
const description = noticia.descripcion || 'Noticia del Club Baloncesto Calasanz';

// Asegurarse de que las propiedades opcionales tengan valores por defecto
const {
  contenido = '',
  imagen = '',
  categoria = 'Noticia',
  tieneComponenteEspecial = false,
  tieneFormulario = false,
  tipoFormulario = ''
} = noticia;

// Importar dinámicamente los componentes necesarios
let EquiposTemporada = null;

if (tieneComponenteEspecial) {
  try {
    const module = await import('../../components/equipos/EquiposTemporada.astro');
    EquiposTemporada = module.default;
  } catch (error) {
    console.error('Error al cargar el componente EquiposTemporada:', error);
  }
}

---
<Layout title={title} description={description}>
  <main class="min-h-screen bg-[#0a1f1c] container mx-auto px-6 sm:px-12 lg:px-24 py-20 sm:py-28 max-w-7xl">
    <div class="mb-8">
      <a href="/news" class="inline-flex items-center text-green-400 hover:text-green-300 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        Volver a noticias
      </a>
    </div>
    
    {!noticia ? (
      <div class="bg-red-900/20 border border-red-500/30 rounded-xl p-8 text-center">
        <svg class="w-16 h-16 text-red-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h2 class="text-2xl font-bold text-red-400 mb-2">¡Noticia no encontrada!</h2>
        <p class="text-gray-300 mb-6">La noticia que buscas no existe o ha sido eliminada.</p>
        <a href="/news" class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 rounded-lg text-white font-medium transition-all duration-300">
          <span>Volver a noticias</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    ) : (
      <article class="bg-green-900/80 backdrop-blur-sm rounded-xl overflow-hidden shadow-lg border border-green-700/30 mx-auto">
        {imagen && (
          <div class="mb-8 lg:mb-12 rounded-xl overflow-hidden shadow-xl">
            <img 
              src={imagen} 
              alt={noticia.titulo || 'Imagen de la noticia'}
              class="w-full h-64 md:h-96 object-cover"
            />
          </div>
        )}

        <div class="p-6 sm:p-8 md:p-10">
          {categoria && (
            <div class="mb-6">
              <span class="inline-block px-4 py-2 bg-green-600/90 text-white text-sm font-bold rounded-full">
                {categoria}
              </span>
            </div>
          )}
          
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-6">{noticia.titulo}</h1>
          
          {noticia.fecha && (
            <div class="flex items-center gap-4 text-green-300 mb-8">
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="text-sm">
                  {new Date(noticia.fecha).toLocaleDateString('es-ES', { 
                    day: 'numeric', 
                    month: 'long', 
                    year: 'numeric',
                    timeZone: 'UTC' // Asegura que no haya ajuste de zona horaria
                  })}
                </span>
              </div>
              <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span class="text-sm">Club Baloncesto Calasanz</span>
              </div>
            </div>
          )}
          
          <div class="prose prose-lg prose-invert max-w-none text-gray-200">
            {noticia.descripcion && (
              <p class="text-lg leading-relaxed mb-6">
                {noticia.descripcion}
              </p>
            )}
            
            {tieneComponenteEspecial && EquiposTemporada ? (
              <div class="mt-8">
                <EquiposTemporada client:load />
              </div>
            ) : noticia.contenido ? (
              <div class="mt-8 space-y-6" set:html={noticia.contenido}></div>
            ) : (
              <div class="p-4 bg-yellow-900/30 border border-yellow-700/50 rounded-lg text-center">
                <p class="text-yellow-200">No hay contenido disponible para esta noticia.</p>
              </div>
            )}
            
            {tieneFormulario && (
              <div class="mt-12">
                <NewsForm tipoFormulario={tipoFormulario} />
              </div>
            )}
          </div>
        </div>
      </article>
    )}
  </main>
</Layout>