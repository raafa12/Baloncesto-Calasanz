---
// src/pages/resultados.astro
import Layout from '../layouts/Layout.astro';
import SectionContainer from "../components/SectionContainer.astro";
import TitleSection from "../components/TitleSection.astro";
import StatisticsIcon from "../assets/Statistics.astro";
import SelectorJornada from '../components/SelectorJornada.astro';
import SelectorSeccion from '../components/SelectorSeccion.astro';
import ResultadosJornadaConActuaciones from '../components/ResultadosJornadaConActuaciones.astro';

// Obtener parámetros de la URL, o usar valores predeterminados
const jornadaParam = Astro.url.searchParams.get('jornada');
const seccionParam = Astro.url.searchParams.get('seccion');
const jornada = jornadaParam || "ultima";
const seccion = seccionParam || "masculina";
---

<Layout title="Resultados | Club Baloncesto Calasanz" description="Resultados de las jornadas del Club Baloncesto Calasanz">
  <main class="px-4 py-24">
    <SectionContainer id="resultados">
      <TitleSection>
        <StatisticsIcon class="size-8" />
        Resultados de la Jornada
      </TitleSection>
      
      <!-- Selector de Jornada -->
      <div class="mt-8">
        <SelectorJornada jornadaActual={jornada} />
      </div>
      
      <!-- Selector de Sección -->
      <div class="mt-4">
        <SelectorSeccion seccionActual={seccion} />
      </div>
      
      <!-- Resultados de la jornada con actuaciones destacadas -->
      <div class="mt-8">
        <div class="bg-green-950 border border-green-800 rounded-xl overflow-hidden shadow-lg">
          <div class="p-6">
            <ResultadosJornadaConActuaciones 
              jornadaSeleccionada={jornada} 
              seccionSeleccionada={seccion} 
            />
          </div>
        </div>
      </div>
    </SectionContainer>
  </main>
</Layout>