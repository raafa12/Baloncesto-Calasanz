---
import Layout from '../../../layouts/Layout.astro';
import ResultadosJornadaConActuaciones from '../../../components/ResultadosJornadaConActuaciones.astro';
import SelectorJornada from '../../../components/SelectorJornada.astro';
import { obtenerJornadas } from '../../../data/jornadas/temporadas';

// Obtener todas las jornadas disponibles
const jornadas = await obtenerJornadas();

// Parámetros de URL
const jornadaNumeroSeleccionada = Astro.params.id || "ultima";
const seccionSeleccionada = Astro.url.searchParams.get('seccion') || "masculina";

// Buscar la jornada específica de forma dinámica
let jornadaSeleccionada = null;
if (jornadaNumeroSeleccionada !== "ultima") {
  jornadaSeleccionada = jornadas.find(j => j.info.numero === parseInt(jornadaNumeroSeleccionada));

  // Si no se encuentra, mostrar un mensaje de error o redirigir
  if (!jornadaSeleccionada) {
    jornadaSeleccionada = { info: { numero: jornadaNumeroSeleccionada, mensaje: "Jornada no encontrada" } };
  }
}
---

<Layout title={`Resultados J${jornadaNumeroSeleccionada} - CB Calasanz`}>
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-green-200 mb-8">Resultados Jornada {jornadaNumeroSeleccionada}</h1>

    <!-- Selector Jornada -->
    <SelectorJornada 
      jornadas={jornadas}
      jornadaSeleccionada={jornadaNumeroSeleccionada}
      seccion={seccionSeleccionada}
    />

    <!-- Pestañas de Sección -->
    <div class="flex mb-6 border-b border-green-800">
      <a href={`?seccion=masculina`} class={`pb-2 px-4 font-medium ${
        seccionSeleccionada !== 'femenina'
          ? 'text-white border-b-2 border-blue-500'
          : 'text-gray-400 hover:text-white'
      }`}>
        Sección Masculina
      </a>
      <a href={`?seccion=femenina`} class={`pb-2 px-4 font-medium ${
        seccionSeleccionada === 'femenina'
          ? 'text-white border-b-2 border-pink-500'
          : 'text-gray-400 hover:text-white'
      }`}>
        Sección Femenina
      </a>
    </div>

    <!-- Resultados -->
    {jornadaSeleccionada.mensaje 
      ? <p class="text-red-500">{jornadaSeleccionada.mensaje}</p> 
      : <ResultadosJornadaConActuaciones 
          jornadaNumero={jornadaNumeroSeleccionada}
          seccionSeleccionada={seccionSeleccionada}
        />
    }

    <div class="mt-10 text-center">
      <a href="/resultados/historico" class="text-green-400 hover:text-green-300 underline">
        Ver histórico de resultados
      </a>
    </div>
  </div>
</Layout>

