---
import Layout from '../../../layouts/Layout.astro';
import ResultadosJornadaConActuaciones from '../../../components/resultados/ResultadosJornadaConActuaciones.astro';
import SelectorJornada from '../../../components/resultados/jornada/SelectorJornada.astro';
import InfoJornada from '../../../components/resultados/InfoJornada.astro';
import { obtenerJornadas } from '../../../data/jornadas/temporadas';
import { secciones } from '../../../data/equipos';

// Definir interfaces para los tipos
interface JornadaInfo {
  numero: number;
  fechaInicio?: string;
  fechaFin?: string;
  tipo?: string;
  mensaje?: string;
}

interface Jornada {
  info: JornadaInfo;
  resultados: any[];
}

// Obtener todas las jornadas disponibles
const jornadas = await obtenerJornadas() as Jornada[];

// Parámetros de URL
const jornadaNumeroSeleccionada = Astro.params.id || "ultima";
const seccionSeleccionada = Astro.url.searchParams.get('seccion') || "todas";

// Obtener información de la sección seleccionada
const seccionInfo = secciones[seccionSeleccionada] || { nombre: "Todas", color: "green-500" };

// Determinar el título de la página con el número de jornada
let tituloPagina = "Resultados";
if (jornadaNumeroSeleccionada !== "ultima") {
  tituloPagina = `Resultados Jornada ${jornadaNumeroSeleccionada}`;
} else if (jornadas.length > 0) {
  tituloPagina = `Resultados Última Jornada`;
}

// Buscar la jornada específica de forma dinámica
let jornadaSeleccionada: Jornada | { info: { numero: string | number; mensaje: string } } | null = null;
if (jornadaNumeroSeleccionada !== "ultima") {
  const jornadaEncontrada = jornadas.find((j: Jornada) => j.info.numero === parseInt(jornadaNumeroSeleccionada));

  // Si no se encuentra, mostrar un mensaje de error o redirigir
  if (jornadaEncontrada) {
    jornadaSeleccionada = jornadaEncontrada;
  } else {
    jornadaSeleccionada = { info: { numero: jornadaNumeroSeleccionada, mensaje: "Jornada no encontrada" } };
  }
} else if (jornadas.length > 0) {
  // Si es "ultima", tomar la primera jornada (que ya está ordenada de mayor a menor)
  jornadaSeleccionada = jornadas[0];
}
---

<Layout title={`${tituloPagina} - CB Calasanz`} description="Resultados de la jornada del Club Baloncesto Calasanz">
  <div class="container mx-auto px-8 sm:px-16 md:px-24 lg:px-32 pt-16 sm:pt-20 pb-6 sm:pb-8 overflow-x-hidden w-full max-w-6xl">
    <!-- Header con animación (optimizado para móvil) -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 sm:mb-12 md:mb-16">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-green-200 mb-3 sm:mb-4 md:mb-0 relative">
        {tituloPagina}
        <span class="absolute -bottom-2 left-0 w-1/3 h-1 bg-green-400 rounded-full"></span>
      </h1>

      <div class="flex space-x-4">
        <a href="/resultados" class="flex items-center text-green-300 hover:text-green-200 transition-colors text-sm sm:text-base">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Todos los resultados
        </a>
      </div>
    </div>

    <!-- Selector Jornada con botones de sección integrados -->
    <div class="bg-green-900 bg-opacity-20 rounded-xl p-3 sm:p-4 md:p-6 mb-6 sm:mb-8 shadow-md">
      <SelectorJornada 
        jornadas={jornadas}
        jornadaSeleccionada={jornadaNumeroSeleccionada}
        seccion={seccionSeleccionada}
      />
    </div>
    
    <!-- Información de la jornada -->
    <InfoJornada jornada={jornadaNumeroSeleccionada} />
    
    <!-- Indicador de sección seleccionada -->
    {seccionSeleccionada !== "todas" && (
      <div class="mb-6 sm:mb-8">
        <div class="bg-green-900 bg-opacity-20 rounded-xl p-3 sm:p-4 md:p-6 shadow-md">
          <div class="flex items-center mb-4 border-b border-green-700 pb-2">
            <div class={`w-2 h-6 bg-${seccionInfo.color} mr-3 rounded`}></div>
            <h4 class="text-lg font-semibold text-white flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              {seccionInfo.nombre}
            </h4>
          </div>
        </div>
      </div>
    )}

    <!-- Resultados -->
    {(jornadaSeleccionada && 'mensaje' in jornadaSeleccionada.info) ? (
      <div class="bg-red-900 bg-opacity-70 text-white p-6 rounded-lg shadow-lg animate-pulse">
        <div class="flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mr-4 text-red-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div>
            <h3 class="text-xl font-bold mb-1">{jornadaSeleccionada.info.mensaje}</h3>
            <p>Lo sentimos, no pudimos encontrar la jornada solicitada.</p>
          </div>
        </div>
      </div>
    ) : (
      <div class="transition-all duration-300 ease-in-out">
        <ResultadosJornadaConActuaciones 
          jornada={jornadaNumeroSeleccionada}
          seccion={seccionSeleccionada}
        />
      </div>
    )}

    <div class="mt-8 sm:mt-12 text-center">
      <div class="flex flex-col sm:flex-row justify-center items-center gap-3 sm:gap-4">
        <a href="/resultados" class="inline-flex items-center bg-green-800 hover:bg-green-700 text-white font-medium py-2 px-3 sm:px-4 rounded-lg transition-colors shadow-md w-full sm:w-auto justify-center text-sm sm:text-base">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-1 sm:mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Volver a resultados
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

