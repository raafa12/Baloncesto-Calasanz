---
import Layout from '../../../layouts/Layout.astro';
import ResultadosJornadaConActuaciones from '../../../components/ResultadosJornadaConActuaciones.astro';
import SelectorJornada from '../../../components/SelectorJornada.astro';
import { obtenerJornadas } from '../../../data/jornadas/temporadas';

// Obtener todas las jornadas disponibles
const jornadas = await obtenerJornadas();

// Parámetros de URL
const jornadaNumeroSeleccionada = Astro.params.id || "ultima";
const seccionSeleccionada = Astro.url.searchParams.get('seccion') || "masculina";

// Buscar la jornada específica de forma dinámica
let jornadaSeleccionada = null;
if (jornadaNumeroSeleccionada !== "ultima") {
  jornadaSeleccionada = jornadas.find(j => j.info.numero === parseInt(jornadaNumeroSeleccionada));

  // Si no se encuentra, mostrar un mensaje de error o redirigir
  if (!jornadaSeleccionada) {
    jornadaSeleccionada = { info: { numero: jornadaNumeroSeleccionada, mensaje: "Jornada no encontrada" } };
  }
}
---

<Layout title={`Resultados J${jornadaNumeroSeleccionada} - CB Calasanz`}>
  <div class="container mx-auto px-4 py-8">
    <!-- Header con animación -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-green-200 mb-4 md:mb-0 relative">
        Jornada {jornadaNumeroSeleccionada}
        <span class="absolute -bottom-2 left-0 w-1/3 h-1 bg-green-400 rounded-full"></span>
      </h1>

      <div class="flex space-x-4">
        <a href="/resultados" class="flex items-center text-green-300 hover:text-green-200 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Todos los resultados
        </a>
        <a href="/calendario" class="flex items-center text-green-300 hover:text-green-200 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Calendario
        </a>
      </div>
    </div>

    <!-- Selector Jornada -->
    <div class="bg-green-900 bg-opacity-20 rounded-xl p-6 mb-8 shadow-md">
      <SelectorJornada 
        jornadas={jornadas}
        jornadaSeleccionada={jornadaNumeroSeleccionada}
        seccion={seccionSeleccionada}
      />
    </div>

    <!-- Pestañas de Sección mejoradas -->
    <div class="flex mb-8 overflow-x-auto no-scrollbar">
      <a href={`?seccion=masculina`} 
         class={`flex-1 py-3 px-6 text-center rounded-t-lg transition-all duration-300 font-medium 
                ${seccionSeleccionada !== 'femenina'
                 ? 'bg-blue-500 bg-opacity-20 text-white border-b-2 border-blue-500'
                 : 'text-gray-400 hover:text-white hover:bg-green-900 hover:bg-opacity-20'}`}>
        <div class="flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Sección Masculina
        </div>
      </a>
      <a href={`?seccion=femenina`} 
         class={`flex-1 py-3 px-6 text-center rounded-t-lg transition-all duration-300 font-medium
                ${seccionSeleccionada === 'femenina'
                 ? 'bg-pink-500 bg-opacity-20 text-white border-b-2 border-pink-500'
                 : 'text-gray-400 hover:text-white hover:bg-green-900 hover:bg-opacity-20'}`}>
        <div class="flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Sección Femenina
        </div>
      </a>
    </div>

    <!-- Resultados -->
    {jornadaSeleccionada?.mensaje ? (
      <div class="bg-red-900 bg-opacity-70 text-white p-6 rounded-lg shadow-lg animate-pulse">
        <div class="flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mr-4 text-red-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div>
            <h3 class="text-xl font-bold mb-1">{jornadaSeleccionada.mensaje}</h3>
            <p>Lo sentimos, no pudimos encontrar la jornada solicitada.</p>
          </div>
        </div>
      </div>
    ) : (
      <div class="transition-all duration-300 ease-in-out">
        <ResultadosJornadaConActuaciones 
          jornadaNumero={jornadaNumeroSeleccionada}
          seccionSeleccionada={seccionSeleccionada}
        />
      </div>
    )}

    <div class="mt-12 text-center">
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a href="/resultados" class="inline-flex items-center bg-green-800 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg transition-colors shadow-md w-full sm:w-auto justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Volver a resultados
        </a>
        <a href="/resultados/historico" class="inline-flex items-center bg-green-800 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg transition-colors shadow-md w-full sm:w-auto justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Ver histórico completo
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

