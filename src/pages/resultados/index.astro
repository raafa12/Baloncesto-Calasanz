---
import Layout from '../../layouts/Layout.astro';
import ResultadosJornadaConActuaciones from '../../components/resultados/ResultadosJornadaConActuaciones.astro';
import SelectorJornada from '../../components/resultados/jornada/SelectorJornada.astro';
import InfoJornada from '../../components/resultados/InfoJornada.astro';
import { obtenerJornadas } from '../../data/jornadas/temporadas';

// Obtener todas las jornadas
const jornadas = await obtenerJornadas();
const ultimaJornada = jornadas[0];

// Extraer parámetros de la URL
const jornadaNumero = Astro.url.searchParams.get('jornada') || "ultima";
---

<Layout title="Resultados - CB Calasanz">
  <div class="container mx-auto px-8 sm:px-16 md:px-24 lg:px-32 pt-16 sm:pt-20 pb-6 sm:pb-12 overflow-x-hidden w-full max-w-6xl">


    <!-- Selector Jornada (optimizado para móvil) -->
    <div class="bg-green-900 bg-opacity-20 rounded-xl p-3 sm:p-4 md:p-6 mb-6 sm:mb-8 shadow-md">
      <div class="mb-3 sm:mb-4">
        <h3 class="text-base sm:text-lg font-semibold text-white flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Seleccionar Jornada
        </h3>
      </div>
      
      <SelectorJornada 
        jornadas={jornadas}
        jornadaSeleccionada={jornadaNumero}
      />
    </div>

    <!-- Información de la jornada -->
    <InfoJornada jornada={jornadaNumero} />

    <!-- Contenedor para ambas secciones (optimizado para móvil) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
      <!-- Sección Masculina -->
      <div class="bg-green-900 bg-opacity-20 rounded-xl p-4 md:p-6 shadow-md">
        <div class="flex items-center mb-4 border-b border-green-700 pb-2">
          <div class="w-2 h-6 bg-blue-500 mr-3 rounded"></div>
          <h4 class="text-lg font-semibold text-white flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            Sección Masculina
          </h4>
        </div>
        
        <ResultadosJornadaConActuaciones 
          jornada={jornadaNumero}
          seccion="masculina"
        />
      </div>
      
      <!-- Sección Femenina -->
      <div class="bg-green-900 bg-opacity-20 rounded-xl p-4 md:p-6 shadow-md">
        <div class="flex items-center mb-4 border-b border-green-700 pb-2">
          <div class="w-2 h-6 bg-pink-500 mr-3 rounded"></div>
          <h4 class="text-lg font-semibold text-white flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            Sección Femenina
          </h4>
        </div>
        
        <ResultadosJornadaConActuaciones 
          jornada={jornadaNumero}
          seccion="femenina"
        />
      </div>
    </div>

    <div class="mt-12 text-center">
      <a href="/resultados/historico" class="inline-flex items-center bg-green-800 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg transition-colors shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Ver histórico de resultados
      </a>
    </div>
  </div>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
