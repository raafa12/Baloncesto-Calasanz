---
import Layout from '../../layouts/Layout.astro';
import ResultadosJornadaConActuaciones from '../../components/ResultadosJornadaConActuaciones.astro';
import SelectorJornada from '../../components/SelectorJornada.astro';
import { obtenerJornadas } from '../../data/jornadas/temporadas';

// Obtener todas las jornadas
const jornadas = await obtenerJornadas();
const ultimaJornada = jornadas[0];

// Extraer parámetros de la URL
const jornadaNumeroSeleccionada = Astro.url.searchParams.get('jornada') || "ultima";
const seccionSeleccionada = Astro.url.searchParams.get('seccion') || "masculina";
---

<Layout title="Resultados - CB Calasanz">
  <div class="container mx-auto px-4 py-12">
    <!-- Header con animación -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-10">
      <h1 class="text-3xl md:text-4xl font-bold text-green-200 mb-4 md:mb-0 relative">
        Resultados
        <span class="absolute -bottom-2 left-0 w-1/3 h-1 bg-green-400 rounded-full"></span>
      </h1>
      <div class="flex space-x-4">
      </div>
    </div>

    <!-- Pestañas de Sección mejoradas -->
    <div class="flex mb-8 overflow-x-auto no-scrollbar">
      <a href={`?jornada=${jornadaNumeroSeleccionada}&seccion=masculina`} 
         class={`flex-1 py-3 px-6 text-center rounded-t-lg transition-all duration-300 font-medium 
                ${seccionSeleccionada !== 'femenina'
                 ? 'bg-blue-500 bg-opacity-20 text-white border-b-2 border-blue-500'
                 : 'text-gray-400 hover:text-white hover:bg-green-900 hover:bg-opacity-20'}`}>
        <div class="flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Sección Masculina
        </div>
      </a>
      <a href={`?jornada=${jornadaNumeroSeleccionada}&seccion=femenina`} 
         class={`flex-1 py-3 px-6 text-center rounded-t-lg transition-all duration-300 font-medium
                ${seccionSeleccionada === 'femenina'
                 ? 'bg-pink-500 bg-opacity-20 text-white border-b-2 border-pink-500'
                 : 'text-gray-400 hover:text-white hover:bg-green-900 hover:bg-opacity-20'}`}>
        <div class="flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          Sección Femenina
        </div>
      </a>
    </div>

        <!-- Selector Jornada -->
    <div class="bg-green-900 bg-opacity-20 rounded-xl p-6 mb-8 shadow-md">
      <SelectorJornada 
        jornadas={jornadas}
        jornadaSeleccionada={jornadaNumeroSeleccionada}
        seccion={seccionSeleccionada}
      />
    </div>

    <!-- Resultados mejorados -->
    <div class="transition-all duration-300 ease-in-out">
      <ResultadosJornadaConActuaciones 
        jornadaNumero={jornadaNumeroSeleccionada} 
        seccionSeleccionada={seccionSeleccionada}
      />
    </div>

    <div class="mt-12 text-center">
      <a href="/resultados/historico" class="inline-flex items-center bg-green-800 hover:bg-green-700 text-white font-medium py-2 px-4 rounded-lg transition-colors shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Ver histórico de resultados
      </a>
    </div>
  </div>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
