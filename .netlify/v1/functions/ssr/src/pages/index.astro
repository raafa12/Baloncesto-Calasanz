---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import AboutMe from "../components/home/AboutMe.astro";
import Hero from "../components/home/Hero.astro";
import SectionContainer from "../components/common/SectionContainer.astro";
import TitleSection from "../components/common/TitleSection.astro";
import FeatureCard from "../components/common/FeatureCard.astro";
import TeamIcon from "../assets/Teams.astro";
import CalendarIcon from "../assets/Calendar.astro";
import NewsIcon from "../assets/News.astro";
---

<Layout
  title="Club Baloncesto Calasanz"
  description="Club de baloncesto con más de 50 años formando personas a través del deporte en el Colegio Calasanz-Escolapios de Santander."
>
  <main class="px-4">
    <!-- Hero Section -->
    <SectionContainer class="pt-6 pb-2 md:pb-4">
      <Hero />
    </SectionContainer>

    <!-- Features Section -->
    <SectionContainer class="py-4 md:py-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10">
        <!-- Equipos Feature Card -->
        <FeatureCard 
          title="Nuestros Equipos" 
          href="/teams" 
          imageSrc="/images/BanquilloFem.jpeg"
          imageAlt="Equipo femenino de baloncesto Calasanz"
          icon={TeamIcon}
        >
          Conoce a nuestros jugadores y categorías desde Benjamín hasta Senior. 
          Descubre los valores que compartimos y la familia que formamos.
        </FeatureCard>

        <!-- Resultados Feature Card -->
        <FeatureCard 
          title="Resultados y Clasificación" 
          href="/results" 
          imageSrc="https://conviveyestudia.org/wp-content/uploads/2020/04/campo-colegio-calasanz-santander.jpg"
          imageAlt="Cancha de baloncesto del Colegio Calasanz"
          icon={CalendarIcon}
        >
          Consulta los últimos resultados, la clasificación actualizada y los próximos 
          partidos de todos nuestros equipos.
        </FeatureCard>
      </div>
    </SectionContainer>

    <!-- Sobre Nosotros Section -->
    <SectionContainer id="sobre-nosotros" class="pt-2 pb-4 md:pb-8">
      <TitleSection>
        <TeamIcon class="size-8" />
        Sobre nosotros
      </TitleSection>
      <AboutMe />
    </SectionContainer>

    <!-- Últimas Noticias Section -->
    <SectionContainer id="noticias" class="py-4 md:py-8">
      <TitleSection>
        <NewsIcon class="size-8" />
        Últimas Noticias
      </TitleSection>
      
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Noticia Principal -->
        <div class="bg-green-950 rounded-2xl overflow-hidden shadow-lg border border-green-800/30 hover:border-green-500/40 transition-all duration-300 group md:col-span-2 max-w-4xl mx-auto w-full">
          <div class="flex flex-col md:flex-row h-full">
            <!-- Imagen de la noticia (ocupa todo el ancho en móvil, mitad en desktop) -->
            <div class="w-full md:w-1/2 h-52 md:h-auto relative overflow-hidden">
              <img 
                src="/images/basket.JPEG" 
                alt="Campus de verano 2025" 
                class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
                style="object-position: center 30%;"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-green-950/80 to-transparent md:bg-gradient-to-r"></div>
            </div>
            
            <!-- Contenido de la noticia -->
            <div class="p-6 md:p-8 flex-1 flex flex-col justify-center">
              <div class="flex items-center gap-2 mb-2">
                <span class="inline-flex items-center justify-center h-8 w-8 rounded-full bg-green-500/20">
                  <svg class="h-4 w-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </span>
                <p class="text-green-400 text-sm font-medium">10 Abril, 2025</p>
              </div>
              
              <h3 class="text-white font-bold text-xl sm:text-2xl md:text-3xl mb-3 group-hover:text-green-300 transition-colors">Campus de verano 2025: ¡Inscríbete ya!</h3>
              
              <p class="text-gray-300 text-sm md:text-base mb-6">Ya están abiertas las inscripciones para nuestro campus de verano. Plazas limitadas. Aprende con los mejores entrenadores y disfruta de un verano lleno de baloncesto.</p>
              
              <a href="/noticias/campus-verano" class="self-start inline-flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 rounded-lg text-white font-medium transition-all duration-300 group">
                <span>Leer más</span>
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <div class="flex justify-center mt-8">
        <a href="/news" class="inline-flex items-center gap-2 px-6 py-3 bg-green-500/20 hover:bg-green-500/40 rounded-full text-green-400 font-medium transition-all duration-300 group">
          <span>Ver todas las noticias</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </SectionContainer>
  </main>
</Layout>